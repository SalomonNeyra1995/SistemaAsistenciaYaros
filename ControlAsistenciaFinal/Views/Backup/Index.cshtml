        @section Scripts {
            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
            <script>
        var datosRestauracion = {};

        // ============================================
        // FUNCIONES PARA MANEJAR EL OVERLAY DE PROGRESO
        // ============================================

        function mostrarProgreso(titulo, mensaje) {
            $('#overlayTitulo').text(titulo || 'Restaurando datos...');
            $('#overlayMensaje').text(mensaje || 'Por favor espere, este proceso puede tomar varios minutos');
            $('#overlayBar').css('width', '100%');
            $('#overlayBar').addClass('animated');
            $('#btnCerrarOverlay').removeClass('visible');
            $('#overlayProgreso').addClass('show').show();
        }

        function ocultarProgreso() {
            $('#overlayProgreso').removeClass('show').hide();
            $('.modal-backdrop').remove();
            $('body').removeClass('modal-open');
            $('body').css('overflow', '');
            $('body').css('padding-right', '');
        }

        function finalizarProgreso() {
            $('#btnCerrarOverlay').addClass('visible');
            $('#overlayTitulo').text('Proceso completado');
            $('#overlayMensaje').text('Puede cerrar esta ventana');
            $('#overlayBar').css('width', '100%');
            $('#overlayBar').removeClass('animated');
        }

        $('#btnCerrarOverlay').click(function() {
            ocultarProgreso();
        });

        $('#overlayProgreso').click(function(e) {
            if ($(e.target).is('#overlayProgreso')) {
                ocultarProgreso();
            }
        });

        // ============================================
        // FUNCIÓN PARA OBTENER NOMBRE DEL MES
        // ============================================

        function obtenerNombreMes(mes) {
            var nombres = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
                           'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
            return nombres[mes - 1] || mes;
        }

        // ============================================
        // DESCARGA DE BACKUP
        // ============================================

        $('.btn-descargar, .btn-descargar-backup').click(function() {
            var anio = $(this).data('anio');
            var mes = $(this).data('mes');
            var archivo = $(this).data('archivo');
            window.location.href = '@Url.Action("DescargarBackup", "Backup")?anio=' + anio + '&mes=' + mes + '&archivo=' + encodeURIComponent(archivo);
        });

        // ============================================
        // GENERAR BACKUP
        // ============================================

        $('#btnGenerarBackup').click(function() {
            var anio = $('#anioBackup').val();
            var mes = $('#mesBackup').val();
            var nombreMes = $('#mesBackup option:selected').text();

            Swal.fire({
                title: 'Generando respaldo...',
                text: 'Respaldo del mes ' + nombreMes + ' ' + anio,
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: '@Url.Action("GenerarBackup", "Backup")',
                type: 'POST',
                data: { anio: anio, mes: mes },
                success: function(response) {
                    Swal.close();
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '¡Respaldo generado!',
                            text: response.mensaje,
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => { location.reload(); });
                    } else {
                        Swal.fire('Error', response.mensaje, 'error');
                    }
                },
                error: function() {
                    Swal.close();
                    Swal.fire('Error', 'No se pudo generar el respaldo', 'error');
                }
            });
        });

        $('#btnBackupMesAnterior').click(function() {
            Swal.fire({
                title: 'Generando respaldo...',
                text: 'Respaldo del mes anterior',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: '@Url.Action("GenerarBackupMesAnterior", "Backup")',
                type: 'POST',
                success: function(response) {
                    Swal.close();
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '¡Respaldo generado!',
                            text: response.mensaje,
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => { location.reload(); });
                    } else {
                        Swal.fire('Error', response.mensaje, 'error');
                    }
                },
                error: function() {
                    Swal.close();
                    Swal.fire('Error', 'No se pudo generar el respaldo', 'error');
                }
            });
        });

        // ============================================
        // SUBIR ARCHIVO
        // ============================================

        var archivoSubido = null;
        var tablasArchivoSubido = [];

        $('#fileExcelRestaurar').on('change', function () {
            var fileInput = document.getElementById('fileExcelRestaurar');
            var file = fileInput.files[0];

            if (file) {
                var extension = file.name.split('.').pop().toLowerCase();
                if (extension === 'xlsx') {
                    $('#btnSubirArchivo').prop('disabled', false);
