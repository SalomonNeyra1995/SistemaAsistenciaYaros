 
@model System.Data.DataTable
@{
    ViewBag.Title = "Gestionar Solicitudes Excepcionales";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-bell"></i> Gestionar Solicitudes Excepcionales</h2>
        <p class="text-muted">Apruebe o rechace las solicitudes de marcación manual de los trabajadores</p>
    </div>
</div>

<div class="card">
    @*<div class="card-header bg-warning text-dark">
        <i class="fas fa-clock"></i> Solicitudes Pendientes
    </div>*@


    <div class="card">
        <div class="card-header bg-warning text-white">
            <i class="fas fa-clock me-2" style="color: black;"></i> Solicitudes Pendientes
        </div>


        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Empleado</th>
                            <th>Email</th>
                            <th>Tipo</th>
                            <th>Fecha/Hora Solicitada</th>
                            <th>Justificación</th>
                            <th>Fecha Solicitud</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (System.Data.DataRow row in Model.Rows)
                        {
                            <tr>
                                <td>@row["Id"]</td>
                                <td>@row["NombreCompleto"]</td>
                                <td>@row["Email"]</td>
                                <td>@row["TipoRegistro"]</td>
                                <td>@row["FechaHoraSolicitada"]</td>
                                <td>@row["Justificacion"]</td>
                                <td>@row["FechaSolicitud"]</td>
                                <td>
                                    <button class="btn btn-sm btn-success aprobar-solicitud" data-id="@row["Id"]">
                                        <i class="fas fa-check"></i> Aprobar
                                    </button>
                                    <button class="btn btn-sm btn-danger rechazar-solicitud" data-id="@row["Id"]">
                                        <i class="fas fa-times"></i> Rechazar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal para comentario -->
    <div class="modal fade" id="modalComentario" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title">Comentario del Administrador</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="solicitudId" />
                    <input type="hidden" id="accion" />
                    <div class="mb-3">
                        <label class="form-label">Comentario (opcional)</label>
                        <textarea id="comentarioAdmin" class="form-control" rows="3" placeholder="Ingrese un comentario sobre esta solicitud..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" id="btnConfirmar" class="btn btn-primary">Confirmar</button>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
        $(document).ready(function() {
            var solicitudId = 0;
            var accion = '';

            $('.aprobar-solicitud').click(function() {
                solicitudId = $(this).data('id');
                accion = 'aprobar';
                $('#solicitudId').val(solicitudId);
                $('#accion').val(accion);
                $('#comentarioAdmin').val('');
                $('#modalComentario').modal('show');
            });

            $('.rechazar-solicitud').click(function() {
                solicitudId = $(this).data('id');
                accion = 'rechazar';
                $('#solicitudId').val(solicitudId);
                $('#accion').val(accion);
                $('#comentarioAdmin').val('');
                $('#modalComentario').modal('show');
            });

            $('#btnConfirmar').click(function() {
                var solicitudId = $('#solicitudId').val();
                var accion = $('#accion').val();
                var comentario = $('#comentarioAdmin').val();
                var aprobar = (accion === 'aprobar');
                var mensaje = aprobar ? 'aprobar' : 'rechazar';
                var titulo = aprobar ? 'Aprobar' : 'Rechazar';

                Swal.fire({
                    title: '¿' + titulo + ' solicitud?',
                    text: '¿Está seguro de ' + mensaje + ' esta solicitud?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, confirmar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire({ title: 'Procesando...', allowOutsideClick: false, didOpen: function() { Swal.showLoading(); } });

                        $.ajax({
                            url: '@Url.Action("AprobarSolicitudExcepcional", "Admin")',
                            type: 'POST',
                            data: { solicitudId: solicitudId, aprobar: aprobar, comentarioAdmin: comentario },
                            success: function(response) {
                                Swal.close();
                                if (response.success) {
                                    Swal.fire('Éxito', response.message, 'success').then(function() {
                                        location.reload();
                                    });
                                } else {
                                    Swal.fire('Error', response.message || response.error, 'error');
                                }
                            },
                            error: function() {
                                Swal.close();
                                Swal.fire('Error', 'Error al procesar la solicitud', 'error');
                            }
                        });
                    }
                });
            });
        });
        </script>
    }
