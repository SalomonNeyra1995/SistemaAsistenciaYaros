        function mostrarResultadoRestauracion(data) {
            $('#resErroresLista').empty();
            $('#resTablasBody').empty();
            $('#resOmitidosLista').html('');
            $('#resErroresContainer').hide();
            $('#resBtnRecargar').hide();

            $('#resInsertados').text(data.registros || 0);
            $('#resOmitidos').text(data.omitidos || 0);
            $('#resErrores').text(data.errores || 0);
            $('#resTotal').text(data.totalProcesados || 0);

            if (data.success) {
                $('#resEstadoGeneral').show().removeClass('alert-danger').addClass('alert-success');
                $('#resMensajeGeneral').text(data.mensaje || 'Restauración completada exitosamente');
                $('#resEstadoError').hide();
                if (data.registros > 0) {
                    $('#resBtnRecargar').show();
                }
            } else {
                $('#resEstadoGeneral').hide();
                $('#resEstadoError').show().removeClass('alert-success').addClass('alert-danger');
                $('#resMensajeError').text(data.error || 'Error en la restauración');
            }

            var tablasBody = $('#resTablasBody');
            if (data.registrosPorTabla) {
                var tablasKeys = Object.keys(data.registrosPorTabla);
                if (tablasKeys.length === 0) {
                    tablasBody.html('<tr><td colspan="4" class="text-center text-muted">No hay datos disponibles</td></tr>');
                } else {
                    var totalInsertados = 0;
                    var totalOmitidos = 0;
                    tablasKeys.forEach(function(tabla) {
                        var insertados = data.registrosPorTabla[tabla] || 0;
                        var omitidos = data.omitidosPorTabla[tabla] || 0;
                        var estado = data.tablasEstado ? data.tablasEstado[tabla] : 'Completado';
                        var estadoIcon = estado === 'Completado' ?
                            '<span class="badge bg-success">✓ Completado</span>' :
                            '<span class="badge bg-warning">⏳ ' + estado + '</span>';
                        totalInsertados += insertados;
                        totalOmitidos += omitidos;
                        tablasBody.append('<tr>' +
                            '<td><strong>' + tabla + '</strong></td>' +
                            '<td class="text-center"><span class="badge bg-success">' + insertados + '</span></td>' +
                            '<td class="text-center"><span class="badge bg-warning">' + omitidos + '</span></td>' +
                            '<td class="text-center">' + estadoIcon + '</td>' +
                            '</tr>');
                    });
                    tablasBody.append('<tr class="table-light fw-bold">' +
                        '<td>TOTAL</td>' +
                        '<td class="text-center text-success">' + totalInsertados + '</td>' +
                        '<td class="text-center text-warning">' + totalOmitidos + '</td>' +
                        '<td></td>' +
                        '</tr>');
                }
            }

            var omitidosHtml = '';
            if (data.registrosOmitidosDetalle && data.registrosOmitidosDetalle.length > 0) {
                var omitidosLista = data.registrosOmitidosDetalle.slice(0, 50);
                omitidosHtml = '<ul class="list-group list-group-flush">';
                omitidosLista.forEach(function(item) {
                    omitidosHtml += '<li class="list-group-item py-1 text-muted small"><i class="fas fa-minus-circle text-warning me-2"></i>' + item + '</li>';
                });
                if (data.registrosOmitidosDetalle.length > 50) {
                    omitidosHtml += '<li class="list-group-item text-muted small text-center">... y ' + (data.registrosOmitidosDetalle.length - 50) + ' más</li>';
                }
                omitidosHtml += '</ul>';
            } else {
                omitidosHtml = '<p class="text-muted text-center mb-0"><i class="fas fa-check-circle text-success me-2"></i>No se omitieron registros</p>';
            }
            $('#resOmitidosLista').html(omitidosHtml);

            if (data.erroresDetallados && data.erroresDetallados.length > 0) {
                $('#resErroresContainer').show();
                var erroresLista = $('#resErroresLista');
                data.erroresDetallados.forEach(function(error) {
                    erroresLista.append('<li class="list-group-item text-danger small"><i class="fas fa-exclamation-circle me-2"></i>' + error + '</li>');
                });
            } else if (data.errores && data.errores > 0) {
                $('#resErroresContainer').show();
                var erroresLista = $('#resErroresLista');
                erroresLista.append('<li class="list-group-item text-warning small"><i class="fas fa-info-circle me-2"></i>Se encontraron ' + data.errores + ' errores, revise el log para más detalles.</li>');
            }

            $('#modalResultadoRestauracion').modal('show');
        }

