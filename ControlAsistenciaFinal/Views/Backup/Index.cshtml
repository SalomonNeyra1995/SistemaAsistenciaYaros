        // Mostrar resultado de limpieza
        function mostrarResultadoLimpieza(response) {
            var detallesHtml = '';
            if (response.detalles && response.detalles.length > 0) {
                detallesHtml = '<div class="card mt-3"><div class="card-body p-0"><ul class="list-group list-group-flush">';

                var tieneError = false;
                response.detalles.forEach(function (detalle) {
                    var esError = detalle.includes('Error');
                    if (esError) tieneError = true;

                    var icono = esError ? 'fa-times-circle' : 'fa-check-circle';
                    var color = esError ? 'text-danger' : 'text-success';
                    var bgColor = esError ? 'bg-danger bg-opacity-10' : 'bg-success bg-opacity-10';

                    // Detectar si se reinició el identity
                    var identityText = '';
                    if (detalle.includes('IDENTITY reiniciado')) {
                        identityText = ' <span class="badge bg-info">IDENTITY reiniciado</span>';
                    }

                    detallesHtml += '<li class="list-group-item ' + bgColor + '">' +
                        '<i class="fas ' + icono + ' ' + color + ' me-2"></i>' +
                        '<span class="' + color + '">' + detalle + '</span>' +
                        identityText +
                        '</li>';
                });
                detallesHtml += '</ul></div></div>';

                // Agregar mensaje adicional sobre el reinicio de IDENTITY
                if (!tieneError) {
                    detallesHtml += '<div class="alert alert-success mt-3">' +
                        '<i class="fas fa-sync-alt me-2"></i>' +
                        '<strong>¡Contadores reiniciados!</strong> Todos los IDs comenzarán desde 1 en las tablas limpiadas.' +
                        '</div>';
                }
            }

            $('#resLimpiezaMensaje').text(response.mensaje || 'Limpieza completada');
            $('#resLimpiezaExito').show();
            $('#resLimpiezaError').hide();
            $('#resLimpiezaDetalles').html(detallesHtml);
            $('#resLimpiezaRecargar').show();
            $('#modalResultadoLimpieza').modal('show');
        }
