@model List<ControlAsistenciaFinal.Services.BackupInfo>

@{
    ViewBag.Title = "Respaldo y Restauración";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .backup-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .backup-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.15) !important;
        }

    .table-tablas {
        max-height: 200px;
        overflow-y: auto;
    }

        .table-tablas thead th {
            position: sticky;
            top: 0;
            background: white;
            z-index: 1;
        }

    .restore-progress {
        transition: width 0.5s ease;
    }

    .card-header {
        background: linear-gradient(135deg, #00a7eb 0%, #00baff 50%, #00a7eb 100%) !important;
        color: white;
        border-radius: 15px 15px 0 0 !important;
    }

    /* ============================================
       ESTILOS PARA EL OVERLAY DE PROGRESO
       ============================================ */
    #overlayProgreso {
        display: none !important;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.6);
        z-index: 10000;
        justify-content: center;
        align-items: center;
    }

        #overlayProgreso.show {
            display: flex !important;
        }

        #overlayProgreso .overlay-content {
            background: white;
            border-radius: 15px;
            padding: 30px 40px;
            text-align: center;
            min-width: 320px;
            max-width: 450px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.3);
            animation: fadeInOverlay 0.3s ease;
        }

    @@keyframes fadeInOverlay {
        from {
            opacity: 0;
            transform: scale(0.9);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    #overlayProgreso .spinner-border {
        width: 3rem;
        height: 3rem;
        color: #0d6efd;
    }

    #overlayProgreso .progress {
        height: 5px;
        border-radius: 10px;
        background: #e9ecef;
        overflow: hidden;
    }

    #overlayProgreso .progress-bar {
        background: #0d6efd;
        width: 100%;
        transition: width 0.5s ease;
    }

        #overlayProgreso .progress-bar.animated {
            animation: progressAnimation 1.5s ease-in-out infinite;
        }

    @@keyframes progressAnimation {
        0% {
            width: 100%;
        }

        50% {
            width: 70%;
        }

        100% {
            width: 100%;
        }
    }

    #btnCerrarOverlay {
        display: none;
        margin-top: 15px;
    }

        #btnCerrarOverlay.visible {
            display: inline-block !important;
        }

    /* Estilos para botones */
    .btn-eliminar-archivo {
        transition: all 0.3s ease;
    }

        .btn-eliminar-archivo:hover {
            transform: scale(1.05);
        }

    .btn-eliminar-todos-periodo {
        transition: all 0.3s ease;
    }

        .btn-eliminar-todos-periodo:hover {
            transform: scale(1.05);
        }

    .btn-limpiar-tabla {
        transition: all 0.3s ease;
    }

        .btn-limpiar-tabla:hover {
            transform: scale(1.05);
        }

    /* Estilos para el modal de limpieza */
    .cleanup-card {
        border-left: 4px solid #ffc107;
    }

    .table-cleanup-list {
        max-height: 250px;
        overflow-y: auto;
    }

        .table-cleanup-list .form-check {
            padding: 5px 10px;
            border-radius: 5px;
            transition: background 0.2s ease;
        }

            .table-cleanup-list .form-check:hover {
                background: #f8f9fa;
            }

    .badge-cleanup {
        font-size: 0.7rem;
        padding: 3px 8px;
    }

    /* Estilos para el badge de IDENTITY reiniciado */
    .bg-info {
        background-color: #17a2b8 !important;
    }

    .bg-success.bg-opacity-10 {
        background-color: rgba(40, 167, 69, 0.1) !important;
    }

    .bg-danger.bg-opacity-10 {
        background-color: rgba(220, 53, 69, 0.1) !important;
    }

    /* ============================================
       ESTILOS PARA COMPACTAR LA SECCIÓN GENERAR RESPALDO
       ============================================ */
    .card-generar-respaldo .card-body {
        padding: 0.75rem 1rem !important;
    }

    .card-generar-respaldo .mb-3 {
        margin-bottom: 0.5rem !important;
    }

    .card-generar-respaldo .form-label {
        font-size: 0.8rem !important;
        margin-bottom: 0.2rem !important;
    }

    .card-generar-respaldo .form-select {
        padding: 0.25rem 0.5rem !important;
        font-size: 0.8rem !important;
        height: auto !important;
    }

    .card-generar-respaldo .btn-lg {
        padding: 0.3rem 0.5rem !important;
        font-size: 0.8rem !important;
    }

    .card-generar-respaldo .btn {
        padding: 0.3rem 0.5rem !important;
        font-size: 0.75rem !important;
    }

    .card-generar-respaldo hr {
        margin: 0.4rem 0 !important;
    }

    .card-generar-respaldo .alert {
        padding: 0.4rem 0.6rem !important;
        font-size: 0.7rem !important;
        margin-bottom: 0 !important;
    }

    .card-generar-respaldo .card-header {
        padding: 0.4rem 1rem !important;
    }

        .card-generar-respaldo .card-header h5 {
            font-size: 0.9rem !important;
        }

    /* Compactar también la card de limpieza */
    .card-limpieza .card-body {
        padding: 0.5rem 0.75rem !important;
    }

    .card-limpieza .alert {
        padding: 0.3rem 0.5rem !important;
        font-size: 0.7rem !important;
        margin-bottom: 0.3rem !important;
    }

    .card-limpieza .btn-sm {
        padding: 0.15rem 0.3rem !important;
        font-size: 0.65rem !important;
    }

    .card-limpieza .card-header {
        padding: 0.3rem 0.75rem !important;
    }

        .card-limpieza .card-header h5 {
            font-size: 0.8rem !important;
        }

    .card-limpieza hr {
        margin: 0.3rem 0 !important;
    }
</style>

<div class="container-fluid mt-4">
    <!-- Header Principal -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="card border-0 shadow-lg" style="background-color: rgb(89, 90, 89) !important">
                <div class="card-body text-white py-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="mb-0" style="font-size: 1.3rem;"><i class="fas fa-database me-3"></i> Centro de Respaldo y Restauración</h2>
                            <p class="mt-1 mb-0 opacity-75" style="font-size: 0.8rem;">Administre los respaldos de su base de datos de forma segura</p>
                        </div>
                        <div class="text-end">
                            <img src="~/Content/images/logo-yaros.png" alt="Yaros Group" style="height: 55px; width: auto;" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- ============================================ -->
        <!-- PANEL IZQUIERDO - GENERAR Y LIMPIAR (COMPACTADO) -->
        <!-- ============================================ -->
        <div class="col-lg-4 mb-3">
            <!-- Card: Generar Respaldo (COMPACTADO) -->
            <div class="card border-0 shadow-lg backup-card card-generar-respaldo">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-cloud-upload-alt me-2"></i> Generar Nuevo Respaldo</h5>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <label class="form-label fw-bold"><i class="fas fa-calendar me-2"></i> Seleccionar Período</label>
                        <div class="row g-1">
                            <div class="col-6">
                                <select id="anioBackup" class="form-select">
                                    @for (int i = 2024; i <= DateTime.Now.Year + 1; i++)
                                    {
                                        <option value="@i" @(i == DateTime.Now.Year ? "selected" : "")>@i</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6">
                                <select id="mesBackup" class="form-select">
                                    @for (int i = 1; i <= 12; i++)
                                    {
                                        var nombreMes = new DateTime(2026, i, 1).ToString("MMMM", new System.Globalization.CultureInfo("es-ES"));
                                        <option value="@i" @(i == DateTime.Now.Month ? "selected" : "")>@nombreMes</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="d-grid gap-1">
                        <button id="btnGenerarBackup" class="btn btn-success btn-lg">
                            <i class="fas fa-cloud-upload-alt me-2"></i> Generar Respaldo
                        </button>
                        <button id="btnBackupMesAnterior" class="btn btn-outline-secondary">
                            <i class="fas fa-calendar-week me-2"></i> Respaldo del Mes Anterior
                        </button>
                        <button type="button" class="btn btn-info btn-lg mt-1" data-bs-toggle="modal" data-bs-target="#modalSubirArchivo">
                            <i class="fas fa-upload me-2"></i> Subir Respaldo desde PC
                        </button>
                    </div>
                    <hr>
                    <div class="alert alert-info small">
                        <i class="fas fa-info-circle me-2"></i>
                        El respaldo incluye: Usuarios, Registros de Asistencia, Alertas, Notificaciones y Solicitudes del período seleccionado.
                    </div>
                </div>
            </div>

            <!-- Card: Limpieza Rápida de Tablas (COMPACTADO) -->
            <div class="card border-0 shadow-lg mt-2 card-limpieza">
                <div class="card-header" style="background: linear-gradient(135deg, #ffc107 0%, #ff9800 100%); color: #333;">
                    <h5 class="mb-0"><i class="fas fa-broom me-2"></i> Limpieza Rápida de Tablas</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning small">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Precaución:</strong> Eliminará TODOS los registros de las tablas seleccionadas.
                    </div>
                    <div class="d-grid gap-1">
                        <button id="btnLimpiarTablas" class="btn btn-danger btn-sm">
                            <i class="fas fa-broom me-2"></i> Limpiar Tablas Seleccionadas
                        </button>
                        <hr>
                        <div class="row g-1">
                            <div class="col-6">
                                <button type="button" class="btn btn-outline-danger btn-sm w-100 btn-limpiar-tabla"
                                        data-tabla="Usuarios" onclick="limpiarTablaEspecifica('Usuarios')">
                                    <i class="fas fa-users me-1"></i> Usuarios
                                </button>
                            </div>
                            <div class="col-6">
                                <button type="button" class="btn btn-outline-warning btn-sm w-100 btn-limpiar-tabla"
                                        data-tabla="RegistrosAsistencia" onclick="limpiarTablaEspecifica('RegistrosAsistencia')">
                                    <i class="fas fa-clock me-1"></i> Asistencias
                                </button>
                            </div>
                            <div class="col-6">
                                <button type="button" class="btn btn-outline-info btn-sm w-100 btn-limpiar-tabla"
                                        data-tabla="RegistrosExcepcionales" onclick="limpiarTablaEspecifica('RegistrosExcepcionales')">
                                    <i class="fas fa-exclamation-triangle me-1"></i> Excepcionales
                                </button>
                            </div>
                            <div class="col-6">
                                <button type="button" class="btn btn-outline-secondary btn-sm w-100 btn-limpiar-tabla"
                                        data-tabla="AlertasHoras" onclick="limpiarTablaEspecifica('AlertasHoras')">
                                    <i class="fas fa-bell me-1"></i> Alertas
                                </button>
                            </div>
                            <div class="col-6">
                                <button type="button" class="btn btn-outline-primary btn-sm w-100 btn-limpiar-tabla"
                                        data-tabla="NotificacionesAdmin" onclick="limpiarTablaEspecifica('NotificacionesAdmin')">
                                    <i class="fas fa-envelope me-1"></i> Notificaciones
                                </button>
                            </div>
                            <div class="col-6">
                                <button type="button" class="btn btn-outline-success btn-sm w-100 btn-limpiar-tabla"
                                        data-tabla="SolicitudesExcepcionales" onclick="limpiarTablaEspecifica('SolicitudesExcepcionales')">
                                    <i class="fas fa-file-alt me-1"></i> Solicitudes
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================ -->
        <!-- PANEL DERECHO - LISTA DE RESPALDOS            -->
        <!-- ============================================ -->
        <div class="col-lg-8 mb-3">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
                    <h5 class="mb-0" style="font-size: 0.95rem;">
                        <i class="fas fa-history me-2"></i> Respaldo Disponibles
                        <span class="badge bg-light text-dark ms-2">
                            @{
                                var totalArchivos = 0;
                                if (Model != null)
                                {
                                    totalArchivos = Model.Sum(b => b.Archivos != null ? b.Archivos.Count : 0);
                                }
                            }
                            @totalArchivos archivo(s)
                        </span>
                    </h5>
                    <div class="d-flex gap-2">
                        @if (Model != null && Model.Any(b => b.Archivos != null && b.Archivos.Any()))
                        {
                            <button id="btnEliminarTodos" class="btn btn-danger btn-sm">
                                <i class="fas fa-trash-alt me-1"></i> Eliminar Todos
                            </button>
                        }
                    </div>
                </div>
                <div class="card-body p-0">
                    <div style="max-height: 600px; overflow-y: auto;">
                        @if (Model == null || !Model.Any(b => b.Archivos != null && b.Archivos.Any()))
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="fas fa-folder-open fa-4x mb-3 opacity-25"></i>
                                <p>No hay respaldos disponibles. Genere su primer respaldo.</p>
                            </div>
                        }
                        else
                        {
                            // Agrupar por año y mes para evitar duplicados
                            var backupsAgrupados = Model
                                .Where(b => b.Archivos != null && b.Archivos.Any())
                                .GroupBy(b => new { b.Anio, b.Mes })
                                .Select(g => g.First())
                                .OrderByDescending(b => b.Anio)
                                .ThenByDescending(b => b.Mes)
                                .ToList();

                            <div class="list-group list-group-flush">
                                @foreach (var backup in backupsAgrupados)
                                {
                                    <div class="list-group-item p-0 border-0">
                                        <div class="card border-0 rounded-0">
                                            <div class="card-header bg-light py-2 px-3 d-flex justify-content-between align-items-center">
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-folder-open text-warning me-2"></i>
                                                    <strong>@backup.NombreMes @backup.Anio</strong>
                                                    <span class="badge bg-secondary ms-2">@backup.Archivos.Count archivo(s)</span>
                                                </div>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="text-muted small">
                                                        <i class="fas fa-calendar-alt me-1"></i>
                                                        @backup.FechaCreacion.ToString("dd/MM/yyyy")
                                                    </span>
                                                    <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar-todos-periodo"
                                                            data-anio="@backup.Anio" data-mes="@backup.Mes"
                                                            title="Eliminar todos los respaldos de @backup.NombreMes @backup.Anio">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="card-body p-0">
                                                <div class="table-responsive">
                                                    <table class="table table-hover table-sm mb-0">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th style="width: 40%;">Archivo</th>
                                                                <th style="width: 30%;">Fecha Creación</th>
                                                                <th style="width: 30%;">Acciones</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var archivo in backup.Archivos.OrderBy(a => a))
                                                            {
                                                                var rutaCompleta = System.IO.Path.Combine(backup.RutaCarpeta, archivo);
                                                                var fechaCreacion = System.IO.File.Exists(rutaCompleta)
                                                                    ? System.IO.File.GetCreationTime(rutaCompleta)
                                                                    : DateTime.Now;
                                                                <tr>
                                                                    <td>
                                                                        <i class="fas fa-file-excel text-success me-2"></i>
                                                                        <span style="font-size: 0.8rem;">@archivo</span>
                                                                    </td>
                                                                    <td style="font-size: 0.75rem;">
                                                                        <i class="fas fa-calendar-alt me-1"></i>
                                                                        @fechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                                                    </td>
                                                                    <td>
                                                                        <div class="btn-group btn-group-sm" role="group">
                                                                            <button type="button" class="btn btn-info btn-descargar"
                                                                                    data-anio="@backup.Anio"
                                                                                    data-mes="@backup.Mes"
                                                                                    data-archivo="@archivo"
                                                                                    title="Descargar">
                                                                                <i class="fas fa-download"></i>
                                                                            </button>
                                                                            <button type="button" class="btn btn-warning btn-restaurar"
                                                                                    data-anio="@backup.Anio"
                                                                                    data-mes="@backup.Mes"
                                                                                    data-archivo="@archivo"
                                                                                    data-bs-toggle="modal"
                                                                                    data-bs-target="#modalRestaurar"
                                                                                    title="Restaurar">
                                                                                <i class="fas fa-upload"></i>
                                                                            </button>
                                                                            <button type="button" class="btn btn-danger btn-eliminar-archivo"
                                                                                    data-anio="@backup.Anio"
                                                                                    data-mes="@backup.Mes"
                                                                                    data-archivo="@archivo"
                                                                                    title="Eliminar este archivo">
                                                                                <i class="fas fa-trash-alt"></i>
                                                                            </button>
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <style>
    /* Estilos para la lista de respaldos */
    .list-group-item {
        background-color: transparent;
    }

    .list-group-item .card {
        border-radius: 0 !important;
    }

    .list-group-item .card:not(:last-child) {
        border-bottom: 1px solid rgba(0,0,0,0.125) !important;
    }

    .list-group-item .card-header {
        border-bottom: 1px solid rgba(0,0,0,0.125);
        background-color: #f8f9fa;
    }

    .list-group-item .card-header strong {
        font-size: 0.9rem;
    }

    .list-group-item .card-body .table {
        background-color: #fff;
        margin-bottom: 0;
    }

    .list-group-item .card-body .table thead th {
        position: sticky;
        top: 0;
        background: #f8f9fa;
        z-index: 2;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #6c757d;
        border-bottom: 2px solid #dee2e6;
    }

    .list-group-item .card-body .table tbody td {
        vertical-align: middle;
        padding: 0.4rem 0.5rem;
        font-size: 0.8rem;
    }

    .list-group-item .card-body .table tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.05);
    }

    .list-group-item .card-body .table tbody tr:last-child td {
        border-bottom: none;
    }

    /* Botones */
    .list-group-item .btn-group .btn {
        padding: 0.2rem 0.4rem;
        font-size: 0.7rem;
    }

    .list-group-item .btn-group .btn-info {
        color: #fff;
    }

    .list-group-item .btn-group .btn-warning {
        color: #212529;
    }

    .list-group-item .btn-group .btn-danger {
        color: #fff;
    }

    /* Scroll personalizado */
    .card-body > div::-webkit-scrollbar {
        width: 6px;
    }

    .card-body > div::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 3px;
    }

    .card-body > div::-webkit-scrollbar-thumb {
        background: #c1c1c1;
        border-radius: 3px;
    }

    .card-body > div::-webkit-scrollbar-thumb:hover {
        background: #a8a8a8;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .list-group-item .card-header {
            padding: 0.4rem 0.6rem;
        }

        .list-group-item .card-header strong {
            font-size: 0.8rem;
        }

        .list-group-item .card-body .table thead th,
        .list-group-item .card-body .table tbody td {
            font-size: 0.7rem;
            padding: 0.3rem 0.4rem;
        }

        .list-group-item .btn-group .btn {
            padding: 0.15rem 0.3rem;
            font-size: 0.65rem;
        }

        /* Ocultar columna de fecha en móviles */
        .list-group-item .card-body .table thead th:nth-child(2),
        .list-group-item .card-body .table tbody td:nth-child(2) {
            display: none;
        }

        .list-group-item .card-body .table thead th:first-child,
        .list-group-item .card-body .table tbody td:first-child {
            width: 50% !important;
        }

        .list-group-item .card-body .table thead th:last-child,
        .list-group-item .card-body .table tbody td:last-child {
            width: 50% !important;
        }
    }

    @@media (max-width: 576px) {
        .list-group-item .card-header .d-flex {
            flex-wrap: wrap;
        }

        .list-group-item .card-header .d-flex .d-flex:first-child {
            width: 100%;
            margin-bottom: 0.2rem;
        }

        .list-group-item .card-header .d-flex .d-flex:last-child {
            width: 100%;
            justify-content: space-between;
        }
    }
        </style>



        <!-- ============================================ -->
        <!-- OVERLAY DE PROGRESO                          -->
        <!-- ============================================ -->
        <div id="overlayProgreso">
            <div class="overlay-content">
                <div class="spinner-border mb-3" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <h5 id="overlayTitulo">Restaurando datos...</h5>
                <p id="overlayMensaje" class="text-muted small mb-3">Por favor espere, este proceso puede tomar varios minutos</p>
                <div class="progress">
                    <div id="overlayBar" class="progress-bar animated" style="width: 100%;"></div>
                </div>
                <button type="button" id="btnCerrarOverlay" class="btn btn-sm btn-secondary">
                    <i class="fas fa-times me-1"></i> Cerrar
                </button>
            </div>
        </div>

        <!-- ============================================ -->
        <!-- MODAL DE RESTAURACIÓN                        -->
        <!-- ============================================ -->
        <div class="modal fade" id="modalRestaurar" tabindex="-1" data-bs-backdrop="static">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
