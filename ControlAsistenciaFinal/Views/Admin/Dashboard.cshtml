                    </div>
                    <span class="text-white-50 small">Click para ver detalles</span>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-warning text-dark" style="cursor: pointer;" onclick="verTardanzas()">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title">Tardanzas Hoy</h5>
                            <h2 class="mb-0">@ViewBag.TardanzasHoy</h2>
                        </div>
                        <i class="fas fa-clock fa-3x opacity-50"></i>
                    </div>
