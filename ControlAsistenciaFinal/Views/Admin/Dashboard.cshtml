        </div>

        <!-- Tarjeta Presentes Hoy -->
        <div class="col-md-3">
            <div class="card text-white" style="cursor: pointer; background-color: rgb(89, 90, 89) !important;" onclick="verPresentes()">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title">Presentes Hoy</h5>
                            <h2 class="mb-0">@ViewBag.PresentesHoy</h2>
                        </div>
