    }

    btn-entrada:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(72, 168, 76, 0.3);
    }

    .btn-salida {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        border: none;
        color: white;
        border-radius: 16px;
        transition: all 0.3s ease;
        font-weight: 500;
    }

        .btn-salida:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(220, 53, 69, 0.3);
        }

    .btn-almuerzo {
        background: linear-gradient(135deg, #f7b712 0%, #f28117 100%);
        border: none;
        color: white;
        border-radius: 16px;
        transition: all 0.3s ease;
        font-weight: 500;
    }

        .btn-almuerzo:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(255, 193, 7, 0.3);
        }

    .btn-retorno {
        background: linear-gradient(135deg, #00baff 0%, #007beb 100%);
