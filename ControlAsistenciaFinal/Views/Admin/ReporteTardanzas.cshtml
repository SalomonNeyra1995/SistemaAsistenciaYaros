@{
    ViewBag.Title = "Reporte de Tardanzas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var usuarios = ViewBag.Usuarios as System.Data.DataTable;
    var rolesPago = ViewBag.RolesPago as System.Data.DataTable;
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-clock" style="color: rgb(89, 90, 89) !important;"></i> Reporte de Tardanzas</h2>
        <p class="text-muted">Reporte detallado de tardanzas por empleado</p>
    </div>
</div>

<!-- Mostrar errores -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <i class="fas fa-filter text-white"></i> <span class="text-white">Filtros de Búsqueda</span>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-3">
                <label><i class="fas fa-calendar-alt"></i> Fecha Inicio</label>
                <input type="date" id="fechaInicio" class="form-control" value="@ViewBag.FechaInicio" />
            </div>
            <div class="col-md-3">
                <label><i class="fas fa-calendar-alt"></i> Fecha Fin</label>
                <input type="date" id="fechaFin" class="form-control" value="@ViewBag.FechaFin" />
            </div>
            <div class="col-md-3">
                <label><i class="fas fa-user"></i> Empleado</label>
                <select id="usuarioId" class="form-control">
                    <option value="">Todos los empleados</option>
                    @if (usuarios != null)
                    {
                        foreach (System.Data.DataRow row in usuarios.Rows)
                        {
                            <option value="@row["Id"]">@row["NombreCompleto"] (@row["RolPago"])</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label><i class="fas fa-tag"></i> Rol de Pago</label>
                <select id="rolPago" class="form-control">
                    <option value="">Todos los roles</option>
                    @if (rolesPago != null)
                    {
                        foreach (System.Data.DataRow row in rolesPago.Rows)
                        {
                            <option value="@row["RolPago"]">@row["RolPago"]</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="row mt-3">
            <div class="col-12">
                <button type="button" id="btnBuscar" class="btn btn-primary">
                    <i class="fas fa-search"></i> Buscar Tardanzas
                </button>
                <button type="button" id="btnExportar" class="btn btn-success">
                    <i class="fas fa-file-excel"></i> Exportar a Excel
                </button>
                <button type="button" id="btnLimpiar" class="btn btn-secondary">
                    <i class="fas fa-eraser"></i> Limpiar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de Resultados -->
<div class="card">
    <div class="card-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <i class="fas fa-table text-white"></i> <span class="text-white">Detalle de Tardanzas</span>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered" id="tablaTardanzas">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Empleado</th>
                        <th>Email</th>
                        <th>Rol de Pago</th>
                        <th>Fecha</th>
                        <th>Hora Ingreso</th>
                        <th>Turno</th>
                        <th>Minutos</th>
                        <th>Nivel</th>
                    </tr>
                </thead>
                <tbody id="tbodyTardanzas">
                    <tr><td colspan="9" class="text-center">Seleccione fechas y presione "Buscar Tardanzas"</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function() {
            $("#btnBuscar").click(buscarReporte);
            $("#btnExportar").click(exportarExcel);
            $("#btnLimpiar").click(limpiarFiltros);
        });

       function buscarReporte() {
    var fechaInicio = $("#fechaInicio").val();
    var fechaFin = $("#fechaFin").val();
    var usuarioId = $("#usuarioId").val();
    var rolPago = $("#rolPago").val();

    if (!fechaInicio || !fechaFin) {
        Swal.fire({
            icon: 'warning',
            title: 'Atención',
            text: 'Seleccione las fechas'
        });
        return;
    }

    Swal.fire({
        title: 'Buscando...',
        text: 'Procesando datos',
        allowOutsideClick: false,
        didOpen: () => { Swal.showLoading(); }
    });

    $.ajax({
        url: '@Url.Action("ObtenerReporteTardanzas", "Admin")',
        type: 'POST',
        data: {
            fechaInicio: fechaInicio,
            fechaFin: fechaFin,
            usuarioId: usuarioId || '',
            rolPago: rolPago || ''
        },
        dataType: 'json',
        success: function(response) {
            Swal.close();
            if (response.success) {
                var tbody = $("#tbodyTardanzas");
                tbody.empty();

                if (response.data.length === 0) {
                    tbody.html('<tr><td colspan="9" class="text-center py-5 text-success"><i class="fas fa-check-circle fa-2x d-block mb-2"></i>¡Felicidades! No hay tardanzas en el período seleccionado</td></tr>');
                } else {
                    var numero = 1;
                    for (var i = 0; i < response.data.length; i++) {
                        var item = response.data[i];

                        // Badge de turno con gradientes (igual a Mi Jornada)
                        var badgeTurno = item.TipoJornada === 'Mañana'
                            ? '<span class="badge rounded-pill" style="background: linear-gradient(135deg, #00baff 0%, #007beb 100%); color: white; padding: 6px 12px;"><i class="bi bi-brightness-high-fill me-1"></i> Mañana</span>'
                            : '<span class="badge rounded-pill" style="background: linear-gradient(135deg, #f7b712 0%, #f28117 100%); color: white; padding: 6px 12px;"><i class="bi bi-brightness-alt-high-fill me-1"></i> Tarde</span>';

                        // Color del texto según nivel de tardanza
                        var colorMinutos = '';
                        switch(item.NivelTardanza) {
                            case 'Leve':
                                colorMinutos = '#E87C00'; // Naranja para leve
                                break;
                            case 'Moderada':
                                colorMinutos = '#FFD700'; // Amarillo para moderada
                                break;
                            case 'Grave':
                                colorMinutos = '#BD0808'; // Rojo para grave
                                break;
                            default:
                                colorMinutos = '#000000'; // Negro por defecto
                        }

                        // Nivel de tardanza en texto con colores
                        var nivelText = '';
                        switch(item.NivelTardanza) {
                            case 'Leve':
                                nivelText = '<span style="color: #E87C00; font-weight: bold;">⚠️ Leve</span>';
                                break;
                            case 'Moderada':
                                nivelText = '<span style="color: #FFD700; font-weight: bold;">⚠️ Moderada</span>';
                                break;
                            case 'Grave':
                                nivelText = '<span style="color: #BD0808; font-weight: bold;">🔴 Grave</span>';
                                break;
                            default:
                                nivelText = '<span style="color: #6c757d;">❓</span>';
                        }

                        tbody.append(
                            '<tr>' +
                            '<td class="text-center">' + numero++ + '</td>' +
                            '<td>' + escapeHtml(item.NombreCompleto) + '</td>' +
                            '<td>' + escapeHtml(item.Email) + '</td>' +
                            '<td><span class="badge bg-secondary">' + escapeHtml(item.RolPago) + '</span></td>' +
                            '<td>' + item.Fecha + '</td>' +
                            '<td><strong>' + item.HoraIngreso + '</strong></td>' +
                            '<td>' + badgeTurno + '</td>' +
                            '<td><span style="font-weight: bold; color: ' + colorMinutos + ' !important;">' + item.MinutosTardanza + ' min</span></td>' +
                            '<td>' + nivelText + '</td>' +
                            '</tr>'
                        );
                    }
                }
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: response.message
                });
            }
        },
        error: function(xhr, status, error) {
            Swal.close();
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Error al cargar datos: ' + error
            });
        }
    });
}
        function exportarExcel() {
            var fechaInicio = $("#fechaInicio").val();
            var fechaFin = $("#fechaFin").val();
            var usuarioId = $("#usuarioId").val();
            var rolPago = $("#rolPago").val();

            if (!fechaInicio || !fechaFin) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Atención',
                    text: 'Seleccione las fechas'
                });
                return;
            }

            Swal.fire({
                title: 'Generando Excel...',
                text: 'Por favor espere',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            // Crear formulario para POST
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("ExportarTardanzasExcel", "Admin")';

            var campos = [
                { name: 'fechaInicio', value: fechaInicio },
                { name: 'fechaFin', value: fechaFin },
                { name: 'usuarioId', value: usuarioId || '' },
                { name: 'rolPago', value: rolPago || '' }
            ];

            for (var i = 0; i < campos.length; i++) {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = campos[i].name;
                input.value = campos[i].value;
                form.appendChild(input);
            }

            document.body.appendChild(form);
            form.submit();
            document.body.removeChild(form);

            setTimeout(() => {
                Swal.close();
            }, 3000);
        }

        function limpiarFiltros() {
            $("#fechaInicio").val('');
            $("#fechaFin").val('');
            $("#usuarioId").val('');
            $("#rolPago").val('');
            $("#tbodyTardanzas").html('<tr><td colspan="9" class="text-center">Seleccione fechas y presione "Buscar Tardanzas"</td></tr>');
        }

        function escapeHtml(text) {
            if (!text) return '-';
            return text
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }
    </script>
}