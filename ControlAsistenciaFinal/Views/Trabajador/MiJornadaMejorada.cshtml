@{
    ViewBag.Title = "Mi Jornada";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Header con título, bienvenida y logo alineado -->
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="h3 mb-0 fw-bold" style="color: #1d1e20;">
                    <i class="fas fa-calendar-day me-2" style="color: #00a7eb;"></i> Mi Jornada Laboral
                </h1>
                <p class="text-muted mt-2 mb-0">
                    <i></i> Bienvenido, <strong style="color: #00a7eb;">@ViewBag.Nombre</strong>
                    @if (ViewBag.EsAdmin == true)
                    {
                        <span class="badge ms-2 px-3 py-1" style="background: #dc3545;">
                            <i class="fas fa-shield-alt"></i> Administrador
                        </span>
                    }
                </p>
            </div>
            <div class="d-flex align-items-center flex-wrap gap-3">
                <!-- Logo -->
                <div class="logo-container" style="position: relative;">
                    <img src="~/Content/images/Logo_Yaros_Group_2.png" alt="Yaros Group" class="img-fluid" style="height: 83px; width: auto; position: relative; right: 0;" />
                </div>
                <!-- RELOJ -->
                <div class="clock-box-header">
                    <div class="clock-date-header" id="currentDateHeader">@DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", System.Globalization.CultureInfo.GetCultureInfo("es-ES"))</div>
                    <div class="clock-time-header" id="currentTimeHeader">--:--:--</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- COLUMNA IZQUIERDA -->
    <div class="col-lg-5 col-md-12 mb-4">
        <!-- Panel de Marcación -->
        <div class="card border-0 shadow-lg">
            <div class="card-header" style="background: linear-gradient(135deg, #00a7eb 0%, #00baff 50%, #00a7eb 100%);">
                <h5 class="mb-0 text-white card-title-with-bullets">
                    <i class="fas fa-hand-pointer me-2"></i> Panel de Marcación
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-6">
                        <button type="button" class="btn btn-entrada w-100 py-3" onclick="marcar('Entrada')">
                            <i class="fas fa-door-open fa-2x d-block mb-2"></i>
                            <span class="fw-bold">ENTRADA</span>
                        </button>
                    </div>
                    <div class="col-6">
                        <button type="button" class="btn btn-salida w-100 py-3" onclick="marcar('Salida')">
                            <i class="fas fa-door-closed fa-2x d-block mb-2"></i>
                            <span class="fw-bold">SALIDA</span>
                        </button>
                    </div>
                    <div class="col-6">
                        <button type="button" class="btn btn-almuerzo w-100 py-3" onclick="marcar('Almuerzo_Salida')">
                            <i class="fas fa-utensils fa-2x d-block mb-2"></i>
                            <span class="fw-bold">SALIDA ALMUERZO</span>
                        </button>
                    </div>
                    <div class="col-6">
                        <button type="button" class="btn btn-retorno w-100 py-3" onclick="marcar('Almuerzo_Retorno')">
                            <i class="fas fa-utensils fa-2x d-block mb-2"></i>
                            <span class="fw-bold">RETORNO ALMUERZO</span>
                        </button>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="form-group">
                    <label class="fw-bold text-secondary"><i class="fas fa-comment-dots me-2"></i> Comentario (Opcional)</label>
                    <textarea id="txtComentario" class="form-control border-0 bg-light" rows="3" placeholder="Ej: Permiso médico, salida temprano, llegada tarde justificada..."></textarea>
                </div>

                @{
                    bool tienePermisoExcepcional = ViewBag.TienePermisoExcepcional ?? false;
                    string tipoPermisoExcepcional = ViewBag.TipoPermisoExcepcional ?? "Todos";
                }

                @if (tienePermisoExcepcional)
                {
                    <hr class="my-4" />
                    <div class="row mt-2">
                        <div class="col-12">
                            <button type="button" class="btn w-100 py-3" data-bs-toggle="modal" data-bs-target="#modalSolicitudExcepcional"
                                    style="background: #5a5a5a !important; border: none; color: white; border-radius: 16px; transition: all 0.3s ease; font-weight: 500; ">
                                <i class="fas fa-exclamation-triangle fa-2x d-block mb-2"></i>
                                <span class="fw-bold">SOLICITAR MARCACIÓN EXCEPCIONAL</span>
                                <small class="d-block text-white" style="opacity: 0.8;">Use esta opción si olvidó marcar</small>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Tarjeta de Resumen -->
        <div class="card mt-4 border-0 shadow-lg">
            <div class="card-header" style="background: linear-gradient(90deg, #00baff 0%, #00a7eb 100%);">
                <h5 class="mb-0 text-white card-title-with-bullets">
                    <i class="fas fa-chart-simple me-2"></i>
                    @if (ViewBag.EsPlanilla == true)
                    {
                        <span>Resumen del Mes</span>
                    }
                    else if (ViewBag.EsFacilitador == true)
                    {
                        <span>Resumen</span>
                    }
                    else
                    {
                        <span>Resumen del Mes</span>
                    }
                </h5>
            </div>
            <div class="card-body">
                @if (ViewBag.EsFacilitador == true)
                {

                    <!-- CORREGIDO: AGREGAR HORAS TRABAJADAS -->
                    <div class="mb-3">
                        <label class="text-muted">Horas Trabajadas:</label>
                        <h3 class="text-primary">
                            @{
                                double horasTrab = Convert.ToDouble(ViewBag.HorasTrabajadas ?? 0);
                                int horasEnteras = (int)horasTrab;
                                int minutos = (int)((horasTrab - horasEnteras) * 60);
                                string textoHorasFormateado = horasEnteras + " horas ";

                            }
                            @textoHorasFormateado
                        </h3>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted">Horas Objetivo:</label>
                        <h3 class="text-success">
                            @{
                                double horasObj = Convert.ToDouble(ViewBag.HorasObjetivo ?? 160);
                                int horasObjEnteras = (int)horasObj;
                                int minutosObj = (int)((horasObj - horasObjEnteras) * 60);
                                string textoObjFormateado = horasObjEnteras + " horas  ";
                            }
                            @textoObjFormateado
                        </h3>
                    </div>
                    <div class="progress mb-3" style="height: 25px;">
                        @{
                            double horasTrabProg = Convert.ToDouble(ViewBag.HorasTrabajadas ?? 0);
                            double horasObjProg = Convert.ToDouble(ViewBag.HorasObjetivo ?? 160);
                            int porcentaje = horasObjProg > 0 ? (int)((horasTrabProg / horasObjProg) * 100) : 0;
                            porcentaje = Math.Min(porcentaje, 100);
                        }
                        <div class="progress-bar bg-success" role="progressbar" style="width: @porcentaje%;">
                            @porcentaje%
                        </div>
                    </div>
                }
                else if (ViewBag.EsPlanilla == true)
                {
                    <div class="text-center">
                        <i class="fas fa-calendar-check fa-3x text-primary mb-3"></i>
                        <h4 class="text-muted">Días Trabajados en el Mes</h4>
                        <h2 class="text-success">@ViewBag.DiasTrabajadosPlanilla</h2>
                        <p class="text-muted small">Total de días que ha completado (entrada + salida)</p>
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label class="text-muted">Horas Trabajadas:</label>
                        <h3 class="text-primary">
                            @{
                                double horasTrabDef = Convert.ToDouble(ViewBag.HorasTrabajadas ?? 0);
                                int horasEnterasDef = (int)horasTrabDef;
                                int minutosDef = (int)((horasTrabDef - horasEnterasDef) * 60);
                                string textoHorasFormateadoDef = horasEnterasDef + " horas y " + minutosDef + " minutos";
                            }
                            @textoHorasFormateadoDef
                        </h3>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted">Horas Objetivo:</label>
                        <h3 class="text-success">
                            @{
                                double horasObjDef = Convert.ToDouble(ViewBag.HorasObjetivo ?? 160);
                                int horasObjEnterasDef = (int)horasObjDef;
                                int minutosObjDef = (int)((horasObjDef - horasObjEnterasDef) * 60);
                                string textoObjFormateadoDef = horasObjEnterasDef + " horas y " + minutosObjDef + " minutos";
                            }
                            @textoObjFormateadoDef
                        </h3>
                    </div>
                    <div class="progress mb-3" style="height: 25px;">
                        @{
                            double horasTrabProgDef = Convert.ToDouble(ViewBag.HorasTrabajadas ?? 0);
                            double horasObjProgDef = Convert.ToDouble(ViewBag.HorasObjetivo ?? 160);
                            int porcentajeDef = horasObjProgDef > 0 ? (int)((horasTrabProgDef / horasObjProgDef) * 100) : 0;
                            porcentajeDef = Math.Min(porcentajeDef, 100);
                        }
                        <div class="progress-bar bg-success" role="progressbar" style="width: @porcentajeDef%;">
                            @porcentajeDef%
                        </div>
                    </div>
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        Días completos en el mes: <strong>@ViewBag.DiasTrabajados</strong>
                        <br>
                        <small class="text-muted">* Solo se cuentan los días con entrada y salida registradas</small>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- COLUMNA DERECHA -->
    <div class="col-lg-7 col-md-12 mb-4">
        <!-- Registros de Hoy -->
        <div class="card border-0 shadow-lg">
            <div class="card-header" style="background: linear-gradient(135deg, #00a7eb 0%, #00baff 50%, #00a7eb 100%);">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <h5 class="mb-0 text-white card-title-with-bullets">
                        <i class="fas fa-list-check me-2"></i> Registros de Hoy
                    </h5>
                    <button type="button" id="btnRefrescar" class="btn btn-sm btn-light rounded-pill">
                        <i class="fas fa-sync-alt me-1"></i> Refrescar
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="py-3"><i class="far fa-clock"></i> Hora</th>
                                <th class="py-3"><i class="fas fa-tag"></i> Tipo</th>
                                <th class="py-3"><i class="fas fa-comment"></i> Comentario</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyRegistros">
                            <!-- Skeleton Loading - Aparece instantáneamente -->
                            <tr class="skeleton-row">
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line medium"></span></td>
                                <td><span class="skeleton-line long"></span></td>
                            </tr>
                            <tr class="skeleton-row">
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line medium"></span></td>
                                <td><span class="skeleton-line long"></span></td>
                            </tr>
                            <tr class="skeleton-row">
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line medium"></span></td>
                                <td><span class="skeleton-line long"></span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- SECCIÓN DE TARDANZAS DEL MES -->
        <div class="card border-0 shadow-lg mt-4">
            <div class="card-header" style="background: linear-gradient(135deg, #00a7eb 0%, #00baff 50%, #00a7eb 100%);">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <h5 class="mb-0 text-white card-title-with-bullets">
                        <i class="fas fa-clock me-2"></i> Registros de Tardanza
                    </h5>
                    <span class="badge bg-light text-dark rounded-pill px-3 py-2" id="totalTardanzas">
                        <i class="fas fa-exclamation-triangle me-1" style="color: #ffc107;"></i>
                        Total Tardanzas: <span id="totalTardanzasCount">0</span>
                    </span>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="py-3"><i class="fas fa-calendar-alt"></i> Fecha</th>
                                <th class="py-3"><i class="fas fa-clock"></i> Turno</th>
                                <th class="py-3"><i class="fas fa-door-open"></i> Hora Ingreso</th>
                                <th class="py-3"><i class="fas fa-hourglass-half"></i> Minutos</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyTardanzas">
                            <!-- Skeleton Loading - Aparece instantáneamente -->
                            <tr class="skeleton-row">
                                <td><span class="skeleton-line medium"></span></td>
                                <td><span class="skeleton-line medium"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                            </tr>
                            <tr class="skeleton-row">
                                <td><span class="skeleton-line medium"></span></td>
                                <td><span class="skeleton-line medium"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                            </tr>
                            <tr class="skeleton-row">
                                <td><span class="skeleton-line medium"></span></td>
                                <td><span class="skeleton-line medium"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                                <td><span class="skeleton-line short"></span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Solicitud Excepcional -->
<div class="modal fade" id="modalSolicitudExcepcional" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-clock"></i> Solicitar Marcación Excepcional</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <i class="fas fa-info-circle"></i> Puede solicitar marcación para CUALQUIER hora del día de hoy.
                </div>
                <div class="mb-3">
                    <label class="form-label">Tipo de Registro *</label>
                    <select id="tipoSolicitud" class="form-control"></select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Hora *</label>
                    <input type="time" id="horaSolicitud" class="form-control" required />
                    <small class="text-muted">Seleccione la hora que desea registrar (cualquier hora del día de hoy)</small>
                </div>
                <div class="mb-3">
                    <label class="form-label">Justificación *</label>
                    <textarea id="justificacionSolicitud" class="form-control" rows="3" placeholder="Explique por qué necesita registrar esta hora manualmente..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnSolicitar" class="btn btn-primary">Enviar Solicitud</button>
            </div>
        </div>
    </div>
</div>


<!-- ============================================ -->
<!-- MODAL DE ALERTA DE SALIDA PENDIENTE - CON FECHA -->
<!-- ============================================ -->
<div class="modal fade" id="modalAlertaSalida" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" style="border-radius: 20px; border: none; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
            <!-- Header con gradiente rojo -->
            <div class="modal-header" style="background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); border-radius: 20px 20px 0 0; border: none; flex-shrink: 0;">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-white rounded-circle p-2" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; animation: pulseModal 2s infinite;">
                        <i class="fas fa-clock text-danger fa-2x"></i>
                    </div>
                    <div>
                        <h5 class="modal-title text-white fw-bold">
                            <i class="fas fa-exclamation-triangle me-2"></i> ¡Salida Pendiente!
                        </h5>
                        <p class="text-white-50 small mb-0" id="modalFechaPendiente">Fecha pendiente: --</p>
                    </div>
                </div>
            </div>
            <div class="modal-body" style="padding: 25px 30px; overflow-y: auto;">
                <div class="text-center mb-4">
                    <div class="bg-warning bg-opacity-10 rounded-circle p-3 d-inline-block mb-3" style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-door-closed fa-3x text-warning"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Aún no ha registrado su salida</h5>
                    <p class="text-muted" id="modalMensajePendiente">Por favor, recuerde registrar su salida del día pendiente.</p>
                </div>

                <!-- Tarjeta con información de la fecha pendiente -->
                <div class="card border-danger mb-3" style="border-left: 4px solid #dc3545;">
                    <div class="card-body py-2 px-3">
                        <div class="row g-2">
                            <div class="col-6">
                                <small class="text-muted d-block">📅 Fecha Pendiente</small>
                                <strong class="text-danger" id="modalFechaCompleta" style="font-size: 1.1rem;">--</strong>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">⏰ Hora de Entrada</small>
                                <strong class="text-primary" id="modalHoraEntrada" style="font-size: 1.1rem;">--:--</strong>
                            </div>
                        </div>
                        <div class="row g-2 mt-1">
                            <div class="col-6">
                                <small class="text-muted d-block">📆 Días de Retraso</small>
                                <strong class="text-warning" id="modalDiasRetraso" style="font-size: 1.1rem;">--</strong>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">📋 Día de la Semana</small>
                                <strong class="text-info" id="modalDiaSemana" style="font-size: 1.1rem;">--</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="alert alert-warning d-flex align-items-center gap-2" style="border-radius: 12px; background: #fff8e1; border-color: #ffc107;">
                    <i class="fas fa-info-circle text-warning fs-5"></i>
                    <div>
                        <small class="text-dark">Por favor, registre su salida lo antes posible para que el día sea considerado como laborado.</small>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="border-top: 1px solid #e9ecef; padding: 15px 30px; border-radius: 0 0 20px 20px; flex-shrink: 0;">
                <button type="button" class="btn btn-primary rounded-pill px-5" id="btnAceptarAlerta" style="font-weight: 600;">
                    <i class="fas fa-check me-2"></i> Aceptar
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* 3 CÍRCULOS DE COLORES AL LADO IZQUIERDO DEL TÍTULO */
    .card-title-with-bullets {
        display: flex;
        align-items: center;
        position: relative;
    }

        .card-title-with-bullets::before {
            content: "";
            width: 11px;
            height: 11px;
            border-radius: 50%;
            background: #0a0a0a;
            box-shadow: 18px 0 0 #f3000e, 36px 0 0 #ffde00;
            margin-right: 50px;
            flex: 0 0 auto;
        }

    /* Animación para el pulso del icono en el modal */
    @@keyframes pulseModal {
        0% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.3);
        }

        50% {
            transform: scale(1.05);
            box-shadow: 0 0 0 15px rgba(220, 53, 69, 0);
        }

        100% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
        }
    }

    /* Animación de entrada del modal */
    .modal.fade .modal-dialog {
        transform: scale(0.9);
        transition: all 0.3s ease;
    }

    .modal.show .modal-dialog {
        transform: scale(1);
    }

    .btn-danger:hover {
        transform: scale(1.02);
        box-shadow: 0 4px 15px rgba(220, 53, 69, 0.3);
        transition: all 0.3s ease;
    }

    /* RELOJ EN HEADER */
    .clock-box-header {
        border: 2px dashed rgba(0,159,227,.45);
        border-radius: 14px;
        background: linear-gradient(180deg, #ffffff, #f1faff);
        text-align: center;
        padding: 8px 16px;
        min-width: 140px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .clock-date-header {
        color: #3e3f40;
        font-weight: bold;
        font-size: 14px;
        margin-bottom: 4px;
        text-transform: lowercase;
    }

    .clock-time-header {
        color: #00a7eb;
        font-size: 24px;
        font-weight: 900;
        letter-spacing: 1px;
        line-height: 1.2;
    }

    /* TEXTOS */
    .text-primary {
        --bs-text-opacity: 1;
        color: #00baff !important;
    }

    .text-success {
        --bs-text-opacity: 1;
        color: #48a84c !important;
    }

    .text-secondary {
        background: linear-gradient(135deg, #00baff, #00a7eb, #007beb);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent !important;
    }

    /* BOTONES COLORES */
    .btn.bg-success, .bg-success {
        background-color: #009540 !important;
        --bs-bg-opacity: 1;
    }

    .bg-danger {
        --bs-bg-opacity: 1;
        background-color: #e20613 !important;
    }

    /* BOTONES MARCACION */
    .btn-entrada {
        background: linear-gradient(135deg, #48a84c 0%, #50c590 100%);
        border: none;
        color: white;
        border-radius: 16px;
        transition: all 0.3s ease;
        font-weight: 500;
    }

        .btn-entrada:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(72, 168, 76, 0.3);
        }

    .btn-salida {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        border: none;
        color: white;
        border-radius: 16px;
        transition: all 0.3s ease;
        font-weight: 500;
    }

        .btn-salida:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(220, 53, 69, 0.3);
        }

    .btn-almuerzo {
        background: linear-gradient(135deg, #f7b712 0%, #f28117 100%);
        border: none;
        color: white;
        border-radius: 16px;
        transition: all 0.3s ease;
        font-weight: 500;
    }

        .btn-almuerzo:hover {
            transform: translateY(-3px);
