@using ControlAsistenciaFinal.Models
@model CrearUsuarioViewModel
@{
    ViewBag.Title = "Crear Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-user-plus"></i> Crear Nuevo Usuario</h2>
        <p class="text-muted">Complete los datos del nuevo empleado. El email se generará automáticamente.</p>
    </div>
</div>

<div class="card">
    <div class="card-header bg-primary text-white">
        <i class="fas fa-user"></i> Datos Personales
    </div>
    <div class="card-body">
        @if (TempData["Mensaje"] != null && !string.IsNullOrEmpty(TempData["Mensaje"].ToString()))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle"></i> @TempData["Mensaje"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null && !string.IsNullOrEmpty(TempData["Error"].ToString()))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-triangle"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @using (Html.BeginForm("CrearUsuario", "Admin", FormMethod.Post, new { id = "frmCrearUsuario" }))
        {
            @Html.AntiForgeryToken()

            <!-- PRIMERA FILA: Concepto de Pago, Rol -->
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.ConceptoPagoId, new { @class = "form-label" })
                        <select id="ConceptoPagoId" name="ConceptoPagoId" class="form-control" required>
                            <option value="">Seleccione un concepto de pago</option>
                            @{
                                var conceptos = ViewBag.ConceptosPago as System.Data.DataTable;
                                if (conceptos != null && conceptos.Rows.Count > 0)
                                {
                                    foreach (System.Data.DataRow row in conceptos.Rows)
                                    {
                                        string tipo = row["Tipo"].ToString();
                                        string concepto = row["ConceptoPago"].ToString();
                                        object tarifaObj = row["TarifaHora"];
                                        decimal tarifa = (tarifaObj != DBNull.Value) ? Convert.ToDecimal(tarifaObj) : 0;
                                        string label = "";

                                        if (tipo == "Facilitador")
                                        {
                                            label = concepto + " - S/ " + tarifa.ToString("F2") + " por hora";
                                        }
                                        else
                                        {
                                            label = concepto + " - Pago mensual (por días)";
                                        }
                                        <option value="@row["Id"]">@label</option>
                                    }
                                }
                                else
                                {
                                    <option value="">No hay conceptos de pago disponibles</option>
                                }
                            }
                        </select>
                        @Html.ValidationMessageFor(m => m.ConceptoPagoId, "", new { @class = "text-danger" })
                        <small class="text-muted">Facilitadores: pago por horas | Planilla: pago mensual</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Rol, new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.Rol, new SelectList(new[] { "Trabajador Independiente", "Admin", "Empleado" }), "Seleccione un rol", new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Rol, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <!-- NUEVA FILA: Fecha de Inicio -->
            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.FechaInicio, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.FechaInicio, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.FechaInicio, "", new { @class = "text-danger" })
                        <small class="text-muted">Fecha desde la cual empezará a contar sus horas/días</small>
                    </div>
                </div>
            </div>

            <hr />

            <!-- SEGUNDA FILA: DNI y Contraseña -->
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.DNI, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.DNI, new
                        {
                            @class = "form-control",
                            placeholder = "12345678",
                            required = "required",
                            maxlength = "8",
                            minlength = "8",
                            onkeypress = "return soloNumeros(event)",
                            oninput = "validarDNI(this)"
                        })
                        @Html.ValidationMessageFor(m => m.DNI, "", new { @class = "text-danger" })
                        <small class="text-muted">8 dígitos (solo números)</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                        @Html.PasswordFor(m => m.Password, new
                        {
                            @class = "form-control",
                            placeholder = "Ingrese una contraseña",
                            required = "required",
                            minlength = "6",
                            maxlength = "20"
                        })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                        <small class="text-muted">Mínimo 6 caracteres, máximo 20</small>
                    </div>
                </div>
            </div>

            <!-- TERCERA FILA: Nombres, Apellido Paterno, Apellido Materno -->
            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Nombres, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Nombres, new { @class = "form-control", placeholder = "Ej: Yamiliet", required = "required" })
                        @Html.ValidationMessageFor(m => m.Nombres, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.ApellidoPaterno, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.ApellidoPaterno, new { @class = "form-control", placeholder = "Ej: Flores", required = "required" })
                        @Html.ValidationMessageFor(m => m.ApellidoPaterno, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.ApellidoMaterno, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.ApellidoMaterno, new { @class = "form-control", placeholder = "Ej: Ortiz" })
                        @Html.ValidationMessageFor(m => m.ApellidoMaterno, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <!-- CUARTA FILA: Celular, Cuenta Ahorros, Banco -->
            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Celular, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Celular, new
                        {
                            @class = "form-control",
                            placeholder = "999888777",
                            type = "tel",
                            maxlength = "9",
                            minlength = "9",
                            onkeypress = "return soloNumeros(event)",
                            oninput = "validarCelular(this)"
                        })
                        @Html.ValidationMessageFor(m => m.Celular, "", new { @class = "text-danger" })
                        <small class="text-muted">9 dígitos (solo números)</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.CuentaAhorros, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.CuentaAhorros, new
                        {
                            @class = "form-control",
                            placeholder = "12345678901234",
                            maxlength = "20",
                            minlength = "10",
                            onkeypress = "return soloNumeros(event)",
                            oninput = "validarCuenta(this)"
                        })
                        @Html.ValidationMessageFor(m => m.CuentaAhorros, "", new { @class = "text-danger" })
                        <small class="text-muted">Entre 10 y 20 dígitos (solo números)</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Banco, new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.Banco, new SelectList(new[] { "BCP", "BBVA", "SCOTIABANK", "INTERBANK", "OTROS" }), "Seleccione un banco", new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Banco, "", new { @class = "text-danger" })
                        <small class="text-muted">Banco para depósito</small>
                    </div>
                </div>
            </div>

            <!-- QUINTA FILA: Dirección -->
            <div class="row">
                <div class="col-12">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Direccion, new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.Direccion, new { @class = "form-control", rows = 2, placeholder = "Dirección de domicilio" })
                        @Html.ValidationMessageFor(m => m.Direccion, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <hr />

            <div class="row">
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Crear Usuario
                    </button>
                    <a href="@Url.Action("Usuarios", "Admin")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Cancelar
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<!-- Información sobre generación automática -->
<div class="card mt-4">
    <div class="card-header bg-info text-white">
        <i class="fas fa-info-circle"></i> Información
    </div>
    <div class="card-body">
        <p><strong>Generación automática de credenciales:</strong></p>
        <ul>
            <li><strong>Email:</strong> Se genera automáticamente con el formato: <code>primeraLetraNombre.apellidoPaterno + primeraLetraApellidoMaterno@asistenciayaros.com</code></li>
            <li><strong>Ejemplo:</strong> Para "Yamiliet Flores Ortiz" → <code>yfloreso@asistenciayaros.com</code></li>
            <li><strong>Contraseña:</strong> Debe ser ingresada por el administrador (mínimo 6 caracteres)</li>
        </ul>
        <hr />
        <p><strong>Validaciones:</strong></p>
        <ul>
            <li><strong>DNI:</strong> Exactamente 8 dígitos numéricos (no se puede repetir)</li>
            <li><strong>Celular:</strong> Exactamente 9 dígitos numéricos</li>
            <li><strong>Cuenta de Ahorros:</strong> Entre 10 y 20 dígitos numéricos</li>
            <li><strong>Contraseña:</strong> Mínimo 6 caracteres, máximo 20</li>
        </ul>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        function soloNumeros(event) {
            var key = event.keyCode || event.which;
            var tecla = String.fromCharCode(key);
            var numeros = "0123456789";

            if (numeros.indexOf(tecla) === -1 && key !== 8 && key !== 9 && key !== 13 && key !== 46) {
                event.preventDefault();
                return false;
            }
            return true;
        }

        function validarDNI(input) {
            var valor = input.value.replace(/\D/g, '');
            if (valor.length > 8) {
                valor = valor.substring(0, 8);
            }
            input.value = valor;
        }

        function validarCelular(input) {
            var valor = input.value.replace(/\D/g, '');
            if (valor.length > 9) {
                valor = valor.substring(0, 9);
            }
            input.value = valor;
        }

        function validarCuenta(input) {
            var valor = input.value.replace(/\D/g, '');
            if (valor.length > 20) {
                valor = valor.substring(0, 20);
            }
            input.value = valor;
        }

        $(document).ready(function () {
            $("#frmCrearUsuario").on("submit", function (e) {
                var dni = $("#DNI").val();
                var cuenta = $("#CuentaAhorros").val();
                var celular = $("#Celular").val();
                var password = $("#Password").val();
                var errores = "";

                if (dni && dni.length !== 8) {
                    errores += "El DNI debe tener exactamente 8 dígitos.\n";
                }

                if (cuenta && (cuenta.length < 10 || cuenta.length > 20)) {
                    errores += "La Cuenta de Ahorros debe tener entre 10 y 20 dígitos.\n";
                }

                if (celular && celular.length !== 9) {
                    errores += "El Celular debe tener exactamente 9 dígitos.\n";
                }

                if (password && password.length < 6) {
                    errores += "La contraseña debe tener al menos 6 caracteres.\n";
                }

                if (password && password.length > 20) {
                    errores += "La contraseña no debe tener más de 20 caracteres.\n";
                }

                if (errores !== "") {
                    alert(errores);
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}