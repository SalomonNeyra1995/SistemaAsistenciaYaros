@{
    ViewBag.Title = "Reportes Avanzados";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var usuarios = ViewBag.Usuarios as System.Data.DataTable;
    var roles = ViewBag.Roles as System.Data.DataTable;
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-chart-bar"></i> Reportes de Asistencia</h2>
        <p class="text-muted">Visualice horas trabajadas, tardanzas y resumen por empleado</p>
    </div>
</div>

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <i class="fas fa-filter"></i> Filtros de Búsqueda
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-3">
                <label><i class="fas fa-calendar-alt"></i> Fecha Inicio</label>
                <input type="date" id="fechaInicio" class="form-control" value="@DateTime.Now.AddDays(-(DateTime.Now.Day - 1)).ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label><i class="fas fa-calendar-alt"></i> Fecha Fin</label>
                <input type="date" id="fechaFin" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label><i class="fas fa-user"></i> Usuario (Opcional)</label>
                <select id="usuarioId" class="form-control">
                    <option value="">Todos los usuarios</option>
                    @if (usuarios != null)
                    {
                        foreach (System.Data.DataRow row in usuarios.Rows)
                        {
                            <option value="@row["Id"]">@row["NombreCompleto"]</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label><i class="fas fa-tag"></i> Rol (Opcional)</label>
                <select id="rol" class="form-control">
                    <option value="">Todos los roles</option>
                    @if (roles != null)
                    {
                        foreach (System.Data.DataRow row in roles.Rows)
                        {
                            <option value="@row["Rol"]">@row["Rol"]</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="row mt-3">
            <div class="col-12">
                <button type="button" id="btnBuscar" class="btn btn-primary">
                    <i class="fas fa-search"></i> Buscar
                </button>
                <button type="button" id="btnExportar" class="btn btn-success">
                    <i class="fas fa-file-excel"></i> Exportar a Excel
                </button>
                <button type="button" id="btnLimpiar" class="btn btn-secondary">
                    <i class="fas fa-eraser"></i> Limpiar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Resumen por Usuario -->
<div class="card mb-4">
    <div class="card-header bg-info text-white">
        <i class="fas fa-chart-pie"></i> Resumen de Horas por Empleado
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered" id="tablaResumen">
                <thead class="table-dark">
                    <tr>
                        <th>Empleado</th>
                        <th>Email</th>
                        <th>Concepto de Pago</th>
                        <th>Días Trabajados</th>
                        <th>Horas Trabajadas</th>
                        <th>Horas Esperadas</th>
                        <th>Diferencia</th>
                    </tr>
                </thead>
                <tbody id="tbodyResumen">
                    <tr><td colspan="7" class="text-center">Seleccione un rango de fechas</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Detalle Diario -->
<div class="card">
    <div class="card-header bg-success text-white">
        <i class="fas fa-table"></i> Detalle Diario de Asistencia
        <span id="spinner" class="spinner-border spinner-border-sm ms-2" style="display:none;"></span>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered" id="tablaDetalle">
                <thead class="table-dark">
                    <tr>
                        <th>Empleado</th>
                        <th>Email</th>
                        <th>Rol</th>
                        <th>Fecha</th>
                        <th>Entrada</th>
                        <th>Salida Almuerzo</th>
                        <th>Retorno Almuerzo</th>
                        <th>Salida</th>
                        <th>Horas</th>
                        <th>Estado</th>
                        <th>Comentarios</th>
                    </tr>
                </thead>
                <tbody id="tbodyDetalle">
                    <tr><td colspan="11" class="text-center">Seleccione un rango de fechas</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function() {
            $("#btnBuscar").click(buscarReporte);
            $("#btnExportar").click(exportarExcel);
            $("#btnLimpiar").click(limpiarFiltros);
        });

        function buscarReporte() {
            var fechaInicio = $("#fechaInicio").val();
            var fechaFin = $("#fechaFin").val();
            var usuarioId = $("#usuarioId").val();
            var rol = $("#rol").val();

            if (!fechaInicio || !fechaFin) {
                Swal.fire({ icon: 'warning', title: 'Atención', text: 'Seleccione las fechas de inicio y fin' });
                return;
            }

            $("#spinner").show();

            // Detalle diario
            $.ajax({
                url: '@Url.Action("ObtenerReporteHoras", "Admin")',
                type: 'POST',
                data: { fechaInicio: fechaInicio, fechaFin: fechaFin, usuarioId: usuarioId || '', rol: rol || '' },
                dataType: 'json',
                success: function(response) {
                    if (response.success) {
                        var tbody = $("#tbodyDetalle");
                        tbody.empty();

                        if (response.data.length === 0) {
                            tbody.html('<tr><td colspan="11" class="text-center">No hay registros</td</table>');
                        } else {
                            for (var i = 0; i < response.data.length; i++) {
                                var item = response.data[i];
                                var estadoClass = item.EstadoDia === 'Tardanza' ? 'text-warning' : (item.EstadoDia === 'Ausente' ? 'text-danger' : 'text-success');

                                if (item.Fecha && item.Fecha !== '') {
                                    tbody.append(
                                        '<tr>' +
                                        '<td>' + item.NombreCompleto + '</td>' +
                                        '<td>' + item.Email + '</td>' +
                                        '<td>' + item.Rol + '</td>' +
                                        '<td>' + item.Fecha + '</td>' +
                                        '<td>' + (item.HoraEntrada || '-') + '</td>' +
                                        '<td>' + (item.HoraSalidaAlmuerzo || '-') + '</td>' +
                                        '<td>' + (item.HoraRetornoAlmuerzo || '-') + '</td>' +
                                        '<td>' + (item.HoraSalida || '-') + '</td>' +
                                        '<td><strong>' + (item.HorasTrabajadasDia || '0') + '</strong> hrs</td>' +
                                        '<td class="' + estadoClass + '">' + item.EstadoDia + '</td>' +
                                        '<td>' + (item.Comentarios || '-') + '</td>' +
                                        '</tr>'
                                    );
                                }
                            }
                        }
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: response.error });
                    }
                },
                error: function() {
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Error al cargar el reporte' });
                },
                complete: function() { $("#spinner").hide(); }
            });

            // Resumen de horas
            $.ajax({
                url: '@Url.Action("ObtenerResumenHoras", "Admin")',
                type: 'POST',
                data: { fechaInicio: fechaInicio, fechaFin: fechaFin, usuarioId: usuarioId || '', rol: rol || '' },
                dataType: 'json',
                success: function(response) {
                    if (response.success) {
                        var tbody = $("#tbodyResumen");
                        tbody.empty();

                        if (response.data.length === 0) {
                            tbody.html('<tr><td colspan="7" class="text-center">No hay datos</td</tr>');
                        } else {
                            for (var i = 0; i < response.data.length; i++) {
                                var item = response.data[i];
                                var diferenciaClass = item.DiferenciaHoras >= 0 ? 'text-success' : 'text-danger';
                                tbody.append(
                                    '<tr>' +
                                    '<td>' + item.NombreCompleto + '</td>' +
                                    '<td>' + item.Email + '</td>' +
                                    '<td>' + item.ConceptoPago + '</td>' +
                                    '<td>' + item.DiasTrabajados + '</td>' +
                                    '<td><strong>' + item.TotalHorasTrabajadas + '</strong> hrs</td>' +
                                    '<td>' + item.HorasEsperadas + ' hrs</td>' +
                                    '<td class="' + diferenciaClass + '"><strong>' + (item.DiferenciaHoras >= 0 ? '+' : '') + item.DiferenciaHoras + '</strong> hrs</td>' +
                                    '</tr>'
                                );
                            }
                        }
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: response.error });
                    }
                },
                error: function() {
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Error al cargar el resumen' });
                }
            });
        }

        function exportarExcel() {
            var fechaInicio = $("#fechaInicio").val();
            var fechaFin = $("#fechaFin").val();
            var usuarioId = $("#usuarioId").val();
            var rol = $("#rol").val();

            if (!fechaInicio || !fechaFin) {
                Swal.fire({ icon: 'warning', title: 'Atención', text: 'Seleccione las fechas de inicio y fin' });
                return;
            }

            Swal.fire({
                title: 'Generando Excel...',
                text: 'Por favor espere',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            var url = '@Url.Action("ExportarExcel", "Admin")?fechaInicio=' + fechaInicio + '&fechaFin=' + fechaFin + '&usuarioId=' + (usuarioId || '') + '&rol=' + (rol || '');
            window.location.href = url;

            setTimeout(() => { Swal.close(); }, 3000);
        }

        function limpiarFiltros() {
            var hoy = new Date();
            var primerDia = new Date(hoy.getFullYear(), hoy.getMonth(), 1);

            var año = primerDia.getFullYear();
            var mes = (primerDia.getMonth() + 1).toString().padStart(2, '0');
            var dia = primerDia.getDate().toString().padStart(2, '0');
            var fechaInicioStr = año + '-' + mes + '-' + dia;

            $("#fechaInicio").val(fechaInicioStr);
            $("#fechaFin").val(new Date().toISOString().split('T')[0]);
            $("#usuarioId").val('');
            $("#rol").val('');
            $("#tbodyResumen").html('<td><td colspan="7" class="text-center">Seleccione un rango de fechas</td</tr>');
            $("#tbodyDetalle").html('<tr><td colspan="11" class="text-center">Seleccione un rango de fechas</td</tr>');
        }
    </script>
}