                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-danger text-white" style="cursor: pointer;" onclick="verAusentes()">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title">Ausentes Hoy</h5>
                            <h2 class="mb-0">@ViewBag.AusentesHoy</h2>
                        </div>
                        <i class="fas fa-user-slash fa-3x opacity-50"></i>
                    </div>
                    <span class="text-white-50 small">Click para ver detalles</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Menú rápido -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <i class="fas fa-info-circle"></i> Sistema de Asistencia
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 text-center">
                            <div onclick="window.location.href='@Url.Action("ControlPagos", "Admin")'" style="cursor: pointer; display: inline-block;">
                                <i class="fas fa-coins fa-3x text-warning"></i>
                            </div>
                            <h5 class="mt-2">Control de Pagos</h5>
                            <p>Configurar pagos</p>
                        </div>
                        <div class="col-md-3 text-center">
                            <div onclick="window.location.href='@Url.Action("Reportes", "Admin")'" style="cursor: pointer; display: inline-block;">
                                <i class="fas fa-file-alt fa-3x text-success"></i>
                            </div>
                            <h5 class="mt-2">Reportes</h5>
                            <p>Ver reportes</p>
                        </div>
                        <div class="col-md-3 text-center">
                            <div onclick="window.location.href='@Url.Action("ReportePagos", "Admin")'" style="cursor: pointer; display: inline-block;">
                                <i class="fas fa-money-bill-wave fa-3x" style="color: rgba(var(--bs-primary-rgb), 1);"></i>
                            </div>
                            <h5 class="mt-2">Pagos</h5>
                            <p>Gestionar pagos</p>
                        </div>
                        <div class="col-md-3 text-center">
                            <div onclick="window.location.href='@Url.Action("GestionarPermisos", "Admin")'" style="cursor: pointer; display: inline-block;">
                                <i class="fas fa-user-shield fa-3x text-info"></i>
                            </div>
                            <h5 class="mt-2">Permisos Excepcionales</h5>
                            <p>Gestionar permisos</p>
                        </div>
                        <div class="col-md-3 text-center">
                            <a href="@Url.Action("RecuperarUser", "Admin")" style="cursor: pointer; text-decoration: none; color: inherit; display: inline-block;">
                                <div>
                                    <i class="fas fa-key fa-3x text-danger"></i>
                                </div>
                                <h5 class="mt-2">Recuperar Contraseña</h5>
                                <p>Cambiar contraseña de usuarios</p>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para alertas de horas completadas -->
<div class="modal fade" id="modalAlertasHoras" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius: 20px; overflow: hidden;">
            <div class="modal-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <h5 class="modal-title text-white">
                    <i class="fas fa-bell me-2"></i> Alertas de Horas Completadas
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <ul class="nav nav-tabs px-3 pt-3" id="alertasTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="pendientes-tab" data-bs-toggle="tab" data-bs-target="#pendientes" type="button" role="tab">
                            <i class="fas fa-clock"></i> No Leídas <span id="pendientesCount" class="badge bg-danger ms-1">0</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="historico-tab" data-bs-toggle="tab" data-bs-target="#historico" type="button" role="tab">
                            <i class="fas fa-history"></i> Historial
                        </button>
                    </li>
                </ul>

                <div class="tab-content p-3" id="alertasTabsContent">
                    <div class="tab-pane fade show active" id="pendientes" role="tabpanel">
                        <div id="listaAlertasPendientes" class="alertas-container" style="max-height: 500px; overflow-y: auto;">
                            <div class="text-center py-5 text-muted">
                                <i class="fas fa-spinner fa-spin fa-2x mb-2 d-block"></i>
                                Cargando alertas...
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="historico" role="tabpanel">
                        <div id="listaAlertasHistorico" class="alertas-container" style="max-height: 500px; overflow-y: auto;">
                            <div class="text-center py-5 text-muted">
                                <i class="fas fa-spinner fa-spin fa-2x mb-2 d-block"></i>
                                Cargando historial...
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cerrar
                </button>
                <button type="button" id="btnMarcarTodasLeidas" class="btn btn-primary">
                    <i class="fas fa-check-double"></i> Marcar todas como leídas
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para detalles de presentes/tardanzas/ausentes -->
<div class="modal fade" id="modalDetalle" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" id="modalHeader">
                <h5 class="modal-title" id="modalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-striped" id="tablaDetalle">
                        <thead id="theadDetalle"></thead>
                        <tbody id="tbodyDetalle"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Toast personalizado
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 5000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer);
                toast.addEventListener('mouseleave', Swal.resumeTimer);
            }
        });

        $(document).ready(function() {
            cargarAlertasHoras();

            $('#btnAlertasHoras').click(function(e) {
                e.preventDefault();
                $('#modalAlertasHoras').modal('show');
            });
        });

        // ============================================
        // ALERTAS DE HORAS COMPLETADAS
        // ============================================
        function cargarAlertasHoras() {
            $.ajax({
                url: '@Url.Action("ObtenerAlertasHoras", "Admin")',
                type: 'GET',
                dataType: 'json',
                success: function(response) {
                    if (response.success && response.count > 0) {
                        $('#alertaCount').text(response.count).show();

                        Toast.fire({
                            icon: 'info',
                            title: response.count + ' trabajador(es) han alcanzado las horas totales del mes'
                        });
                    } else {
                        $('#alertaCount').hide();
                    }

                    if (response.data && response.data.length > 0) {
                        var pendientesHtml = '';
                        for (var i = 0; i < response.data.length; i++) {
                            var item = response.data[i];
                            var porcentaje = (item.HorasAlcanzadas / item.HorasObjetivo) * 100;
                            porcentaje = Math.min(porcentaje, 100);

                            pendientesHtml += '<div class="alerta-card mb-3 p-3 rounded-3 shadow-sm" style="background: linear-gradient(135deg, #fff9e6 0%, #fff3c9 100%); border-left: 5px solid #ffc107;">' +
                                '<div class="d-flex justify-content-between align-items-start">' +
                                    '<div class="d-flex align-items-center">' +
                                        '<div class="rounded-circle bg-warning text-white d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">' +
                                            '<i class="fas fa-trophy fa-2x"></i>' +
                                        '</div>' +
                                        '<div>' +
                                            '<h6 class="mb-1 fw-bold">' + item.NombreCompleto + '</h6>' +
                                            '<p class="mb-1 text-muted small">' +
                                                '<i class="fas fa-envelope me-1"></i> ' + item.Email +
                                                '<span class="mx-2">•</span>' +
                                                '<i class="fas fa-tag me-1"></i> ' + item.RolPago +
                                            '</p>' +
                                        '</div>' +
                                    '</div>' +
                                    '<span class="badge bg-success rounded-pill">🎯 Meta alcanzada</span>' +
                                '</div>' +
                                '<div class="mt-3">' +
                                    '<div class="d-flex justify-content-between mb-1">' +
                                        '<small class="text-muted">Progreso: ' + porcentaje.toFixed(0) + '%</small>' +
                                        '<small class="text-muted">' + item.HorasAlcanzadas + ' / ' + item.HorasObjetivo + ' hrs</small>' +
                                    '</div>' +
                                    '<div class="progress mb-2" style="height: 8px;">' +
                                        '<div class="progress-bar bg-success" role="progressbar" style="width: ' + porcentaje + '%;"></div>' +
                                    '</div>' +
                                    '<small class="text-muted">' +
                                        '<i class="fas fa-calendar-alt me-1"></i> Alerta generada: ' + item.FechaAlerta +
                                    '</small>' +
                                '</div>' +
                                '<hr class="my-2">' +
                                '<div class="d-flex justify-content-end">' +
                                    '<button class="btn btn-sm btn-outline-success marcar-leida" data-id="' + item.Id + '">' +
                                        '<i class="fas fa-check"></i> Marcar como leída' +
                                    '</button>' +
                                '</div>' +
                            '</div>';
                        }
                        $('#listaAlertasPendientes').html(pendientesHtml);
                        $('#pendientesCount').text(response.data.length);

                        $('.marcar-leida').click(function() {
                            var alertaId = $(this).data('id');
                            marcarAlertaLeida(alertaId);
                        });
                    } else {
                        $('#listaAlertasPendientes').html(
                            '<div class="text-center py-5 text-muted">' +
                                '<i class="fas fa-check-circle fa-3x text-success mb-3 d-block"></i>' +
                                '<p>No hay alertas pendientes</p>' +
                                '<small>Todos los facilitadores están dentro del objetivo</small>' +
                            '</div>'
                        );
                        $('#pendientesCount').text(0);
                    }
                },
                error: function() {
                    $('#listaAlertasPendientes').html(
                        '<div class="text-center py-5 text-danger">' +
                            '<i class="fas fa-exclamation-triangle fa-3x mb-3 d-block"></i>' +
                            '<p>Error al cargar las alertas</p>' +
                        '</div>'
                    );
                }
            });
        }

        function marcarAlertaLeida(alertaId) {
            $.ajax({
                url: '@Url.Action("MarcarAlertaLeida", "Admin")',
                type: 'POST',
                data: { alertaId: alertaId },
                success: function(response) {
                    if (response.success) {
                        cargarAlertasHoras();
                        Swal.fire({
                            icon: 'success',
                            title: '¡Marcada!',
                            text: 'Alerta marcada como leída',
                            timer: 1500,
                            showConfirmButton: false
                        });
                    }
                }
            });
        }

        $('#btnMarcarTodasLeidas').click(function() {
            Swal.fire({
                title: 'Marcar todas como leídas',
                text: '¿Está seguro de marcar todas las alertas como leídas?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí, marcar todas',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("MarcarTodasAlertasLeidas", "Admin")',
                        type: 'POST',
                        success: function(response) {
                            if (response.success) {
                                cargarAlertasHoras();
                                Swal.fire({
                                    icon: 'success',
                                    title: '¡Completado!',
                                    text: 'Todas las alertas han sido marcadas como leídas',
                                    timer: 2000,
                                    showConfirmButton: false
                                });
                            }
                        }
                    });
                }
            });
        });

        // ============================================
        // DETALLES DASHBOARD
        // ============================================
        function verPresentes() {
            $('#modalTitle').text('Empleados Presentes Hoy');
            $('#modalHeader').removeClass().addClass('modal-header text-white');
            $('#modalHeader').css('background-color', 'rgb(89, 90, 89)');
            $('#theadDetalle').html('<tr><th>Nombre</th><th>Email</th><th>Hora Entrada</th><th>Comentario</th></tr>');
            $('#tbodyDetalle').html('<tr><td colspan="4" class="text-center">Cargando...</td></tr>');
            $('#modalDetalle').modal('show');

            $.ajax({
                url: '@Url.Action("ObtenerDetallePresentes", "Admin")',
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    var tbody = $('#tbodyDetalle');
                    tbody.empty();
                    if (data.length === 0) {
                        tbody.html('<tr><td colspan="4" class="text-center">No hay registros</td></tr>');
                    } else {
                        for (var i = 0; i < data.length; i++) {
                            var item = data[i];
                            tbody.append('<tr>' +
                                '<td>' + item.NombreCompleto + '</td>' +
                                '<td>' + item.Email + '</td>' +
                                '<td>' + item.HoraEntrada + '</td>' +
                                '<td>' + (item.Comentario || '-') + '</td>' +
                                '</tr>');
                        }
                    }
                }
            });
        }

        function verTardanzas() {
            $('#modalTitle').text('Empleados con Tardanza Hoy');
            $('#modalHeader').removeClass().addClass('modal-header bg-warning text-dark');
            $('#theadDetalle').html('<tr><th>Nombre</th><th>Email</th><th>Hora Entrada</th><th>Minutos Tarde</th><th>Comentario</th></tr>');
            $('#tbodyDetalle').html('<tr><td colspan="5" class="text-center">Cargando...</td></tr>');
            $('#modalDetalle').modal('show');

            $.ajax({
                url: '@Url.Action("ObtenerDetalleTardanzas", "Admin")',
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    var tbody = $('#tbodyDetalle');
                    tbody.empty();
                    if (data.length === 0) {
                        tbody.html('<tr><td colspan="5" class="text-center">No hay tardanzas</td></tr>');
                    } else {
                        for (var i = 0; i < data.length; i++) {
                            var item = data[i];
                            tbody.append('<tr>' +
                                '<td>' + item.NombreCompleto + '</td>' +
                                '<td>' + item.Email + '</td>' +
                                '<td>' + item.HoraEntrada + '</td>' +
                                '<td>' + item.MinutosTarde + '</td>' +
                                '<td>' + (item.Comentario || '-') + '</td>' +
                                '</tr>');
                        }
                    }
                }
            });
        }

        function verAusentes() {
            $('#modalTitle').text('Empleados Ausentes Hoy');
            $('#modalHeader').removeClass().addClass('modal-header text-white');
            $('#modalHeader').css('background-color', '#dc3545');
            $('#theadDetalle').html('\
                <tr>\
                    <th><i class="fas fa-user me-1"></i> Nombre</th>\
                    <th><i class="fas fa-envelope me-1"></i> Email</th>\
                    <th><i class="fas fa-calendar me-1"></i> Fecha</th>\
                    <th><i class="fas fa-comment me-1"></i> Estado</th>\
                </tr>\
            ');
            $('#tbodyDetalle').html('<tr><td colspan="4" class="text-center"><i class="fas fa-spinner fa-spin me-2"></i>Cargando...</td></tr>');
            $('#modalDetalle').modal('show');

            $.ajax({
                url: '@Url.Action("ObtenerDetalleAusentes", "Admin")',
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    var tbody = $('#tbodyDetalle');
                    tbody.empty();
                    if (data.length === 0) {
                        tbody.html('\
                            <tr>\
                                <td colspan="4" class="text-center py-4">\
                                    <i class="fas fa-check-circle fa-2x text-success mb-2 d-block"></i>\
                                    <span>Todos los empleados están presentes hoy</span>\
                                 </td>\
                            </tr>\
                        ');
                    } else {
                        for (var i = 0; i < data.length; i++) {
                            var item = data[i];
                            tbody.append('\
                                <tr>\
                                    <td><strong>' + escapeHtml(item.NombreCompleto) + '</strong></td>\
                                    <td>' + escapeHtml(item.Email) + '</td>\
                                    <td><span class="badge bg-secondary">' + (item.Fecha || new Date().toLocaleDateString()) + '</span></td>\
                                    <td><span class="badge bg-danger"><i class="fas fa-user-slash me-1"></i> Ausente</span></td>\
                                </tr>\
                            ');
                        }
                    }
                },
                error: function() {
                    $('#tbodyDetalle').html('\
                        <tr>\
                            <td colspan="4" class="text-center text-danger py-4">\
                                <i class="fas fa-exclamation-triangle fa-2x mb-2 d-block"></i>\
                                Error al cargar los datos\
                             </td>\
                        </tr>\
                    ');
                }
            });
        }

        function escapeHtml(text) {
            if (!text) return '-';
            return text
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }
    </script>
}