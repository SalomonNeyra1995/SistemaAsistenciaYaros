        font-weight: 500;
    }

        .btn-retorno:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(23, 162, 184, 0.3);
        }

    /* TABLA */
    .table tbody tr:hover {
        background-color: rgba(102, 126, 234, 0.05);
        cursor: pointer;
    }

    .table td {
        vertical-align: middle;
        padding: 12px 15px;
    }

    .card {
        border-radius: 20px;
        overflow: hidden;
    }

    .badge {
        border-radius: 50px;
        font-weight: 500;
    }

    .progress {
        border-radius: 25px;
        background-color: #e9ecef;
    }

    .progress-bar {
        border-radius: 25px;
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
    }

    /* SCROLLBAR */
    ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    ::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }

    ::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 10px;
    }

        ::-webkit-scrollbar-thumb:hover {
            background: #555;
        }

    /* LOGO RESPONSIVE */
    @@media (min-width: 768px) {
        .logo-container img {
