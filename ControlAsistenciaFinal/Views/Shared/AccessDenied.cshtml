@{
    ViewBag.Title = "Acceso Denegado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-lg border-0" style="border-radius: 20px;">
            <div class="card-body p-5">
                <div class="mb-4">
                    <i class="fas fa-lock fa-4x text-danger"></i>
                </div>
                <h2 class="text-danger mb-3">Acceso Denegado</h2>
                <p class="text-muted mb-4">
                    No tiene permisos para acceder a esta sección.<br />
                    Esta área es exclusiva para administradores.
                </p>
                <a href="@Url.Action("MiJornada", "Trabajador")" class="btn btn-primary btn-lg">
                    <i class="fas fa-arrow-left me-2"></i> Volver a Mi Jornada
                </a>
            </div>
        </div>
    </div>
</div>