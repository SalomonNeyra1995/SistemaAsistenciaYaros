@{
    ViewBag.Title = "Pagos por Ciclo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var usuarios = ViewBag.Usuarios as System.Data.DataTable;
    var rolesPago = ViewBag.RolesPago as System.Data.DataTable;
}

<style>
    .table-responsive {
        overflow-x: auto;
    }

    .badge-excedente {
        background-color: #ffc107;
        color: #856404;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: bold;
    }

    .badge-ciclo {
        background-color: #17a2b8;
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
    }

    .total-row {
        background-color: #2c3e50;
        color: white;
        font-weight: bold;
    }

    .card-header-custom {
        background: linear-gradient(135deg, #00a7eb 0%, #00baff 100%);
    }
</style>

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="fas fa-chart-line"></i> Pagos por Ciclo</h2>
        <p class="text-muted">Calcula el pago basado en horas trabajadas y excedentes acumulados por ciclo</p>
    </div>
</div>

<!-- Filtros -->
<div class="card mb-4 shadow-sm">
    <div class="card-header card-header-custom text-white">
        <i class="fas fa-filter"></i> Filtros de Búsqueda
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="fw-bold"><i class="fas fa-user"></i> Empleado</label>
                <select id="usuarioId" class="form-control">
                    <option value="">Todos los empleados</option>
                    @if (usuarios != null && usuarios.Rows.Count > 0)
                    {
                        foreach (System.Data.DataRow row in usuarios.Rows)
                        {
                            <option value="@row["Id"]">
                                @row["NombreCompleto"] (@row["RolPago"])
                            </option>
                        }
                    }
                    else
                    {
                        <option value="" disabled>No hay empleados registrados</option>
                    }
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="fw-bold"><i class="fas fa-tag"></i> Rol de Pago</label>
                <select id="rolPago" class="form-control">
                    <option value="">Todos los roles</option>
                    @if (rolesPago != null)
                    {
                        foreach (System.Data.DataRow row in rolesPago.Rows)
                        {
                            <option value="@row["RolPago"]">@row["RolPago"]</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="fw-bold"><i class="fas fa-chart-line"></i> Ciclo</label>
                <select id="ciclo" class="form-control">
                    <option value="">Todos los ciclos</option>
                    @if (ViewBag.Ciclos != null)
                    {
                        foreach (System.Data.DataRow row in ViewBag.Ciclos.Rows)
                        {
                            <option value="@row["NombreCiclo"]">@row["NombreCiclo"]</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="row mt-2">
            <div class="col-12">
                <button type="button" id="btnBuscar" class="btn btn-primary me-2">
                    <i class="fas fa-search"></i> Buscar
                </button>
                <button type="button" id="btnExportar" class="btn btn-success me-2">
                    <i class="fas fa-file-excel"></i> Exportar a Excel
                </button>
                <button type="button" id="btnLimpiar" class="btn btn-secondary me-2">
                    <i class="fas fa-eraser"></i> Limpiar
                </button>
                <button type="button" id="btnGenerarTodos" class="btn btn-info">
                    <i class="fas fa-chart-bar"></i> Generar Reporte Completo
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de Resultados -->
<div class="card shadow-sm">
    <div class="card-header card-header-custom text-white">
        <i class="fas fa-table"></i> Detalle de Pago por Empleado - Ciclo
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered" id="tablaPagos">
                <thead class="table-dark">
                    <tr>
                        <th>Empleado</th>
                        <th>Email</th>
                        <th>Rol de Pago</th>
                        <th>Tarifa x Hora</th>
                        <th>Días Trabajados</th>
                        <th>Horas Totales</th>
                        <th>Horas Excedentes</th>
                        <th>Ciclo</th>
                        <th>Monto Total</th>
                        <th>Detalle</th>
                    </tr>
                </thead>
                <tbody id="tbodyPagos">
                    <tr>
                        <td colspan="10" class="text-center text-muted py-5">
                            <i class="fas fa-info-circle fa-2x mb-2 d-block"></i>
                            Seleccione los filtros y presione "Buscar" o "Generar Reporte Completo"
                        </td>
                    </tr>
                </tbody>
                <tfoot id="tfootPagos" style="display: none;">
                    <tr class="total-row">
                        <td colspan="4" class="text-end fw-bold">TOTALES:</td>
                        <td id="totalDias" class="text-center fw-bold">0</td>
                        <td id="totalHoras" class="text-center fw-bold">0</td>
                        <td id="totalExcedentes" class="text-center fw-bold">0</td>
                        <td></td>
                        <td id="totalMonto" class="text-center fw-bold">S/ 0.00</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    $(document).ready(function() {
        $("#btnBuscar").click(buscarReporte);
        $("#btnExportar").click(exportarExcel);
        $("#btnLimpiar").click(limpiarFiltros);
        $("#btnGenerarTodos").click(generarReporteCompleto);
    });

  // Función para buscar reporte
function buscarReporte() {
    var usuarioId = $("#usuarioId").val();
    var rolPago = $("#rolPago").val();
    var ciclo = $("#ciclo").val();

    if (!ciclo) {
        Swal.fire({
            icon: 'info',
            title: 'Atención',
            text: 'Por favor seleccione un ciclo para consultar'
        });
        return;
    }

    Swal.fire({
        title: 'Buscando...',
        text: 'Procesando datos del ciclo ' + ciclo,
        allowOutsideClick: false,
        didOpen: () => { Swal.showLoading(); }
    });

    $.ajax({
        url: '@Url.Action("ObtenerReportePagosPorCiclo", "Admin")',
        type: 'POST',
        data: {
            usuarioId: usuarioId || '',
            rolPago: rolPago || '',
            ciclo: ciclo
        },
        dataType: 'json',
        success: function(response) {
            Swal.close();
            if (response.success) {
                renderizarTabla(response.data);
                if (response.data && response.data.length > 0) {
                    var excedentesAcum = response.data[0].HorasExcedentesAcumuladas || 0;
                    if (excedentesAcum > 0) {
                        Swal.fire({
                            icon: 'info',
                            title: 'Excedentes aplicados',
                            text: `Se aplicaron ${excedentesAcum.toFixed(2)} horas excedentes del ciclo anterior`,
                            timer: 3000,
                            showConfirmButton: false
                        });
                    }
                }
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: response.error || 'Error al cargar datos' });
            }
        },
        error: function(xhr, status, error) {
            Swal.close();
            console.error("Error:", error);
            console.error("Respuesta:", xhr.responseText);
            Swal.fire({ icon: 'error', title: 'Error', text: 'Error al cargar datos: ' + error });
        }
    });
}


    // Función para generar reporte completo
function generarReporteCompleto() {
    var ciclo = $("#ciclo").val();

    if (!ciclo) {
        Swal.fire({
            icon: 'info',
            title: 'Atención',
            text: 'Por favor seleccione un ciclo para generar el reporte'
        });
        return;
    }

    Swal.fire({
        title: 'Generando reporte...',
        text: 'Procesando datos del ciclo ' + ciclo,
        allowOutsideClick: false,
        didOpen: () => { Swal.showLoading(); }
    });

    $.ajax({
        url: '@Url.Action("ObtenerReportePagosPorCiclo", "Admin")',
        type: 'POST',
        data: {
            usuarioId: '',
            rolPago: '',
            ciclo: ciclo
        },
        dataType: 'json',
        success: function(response) {
            Swal.close();
            if (response.success) {
                renderizarTabla(response.data);
                Swal.fire({
                    icon: 'success',
                    title: 'Reporte Generado',
                    text: `Se encontraron ${response.data ? response.data.length : 0} registros`,
                    timer: 2000,
                    showConfirmButton: false
                });
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: response.error || 'Error al cargar datos' });
            }
        },
        error: function(xhr, status, error) {
            Swal.close();
            console.error("Error:", error);
            Swal.fire({ icon: 'error', title: 'Error', text: 'Error al cargar datos: ' + error });
        }
    });
}

    function renderizarTabla(data) {
        var tbody = $("#tbodyPagos");
        tbody.empty();

        if (!data || data.length === 0) {
            tbody.html('<tr><td colspan="11" class="text-center text-muted py-5">No hay datos disponibles para el ciclo seleccionado<\/td><\/tr>');
            $("#tfootPagos").hide();
            return;
        }

        var totalGeneral = 0;
        var totalHorasGeneral = 0;
        var totalDiasGeneral = 0;
        var totalExcedentesGeneral = 0;

        for (var i = 0; i < data.length; i++) {
            var item = data[i];

            // Validar y convertir valores, usando 0 si son undefined o null
            var monto = (item.MontoTotal !== undefined && item.MontoTotal !== null) ? parseFloat(item.MontoTotal) : 0;
            var horas = (item.HorasTotales !== undefined && item.HorasTotales !== null) ? parseFloat(item.HorasTotales) : 0;
            var dias = (item.DiasTrabajados !== undefined && item.DiasTrabajados !== null) ? parseInt(item.DiasTrabajados) : 0;
            var excedentes = (item.HorasExcedentes !== undefined && item.HorasExcedentes !== null) ? parseFloat(item.HorasExcedentes) : 0;
            var excedentesAcumulados = (item.HorasExcedentesAcumuladas !== undefined && item.HorasExcedentesAcumuladas !== null) ? parseFloat(item.HorasExcedentesAcumuladas) : 0;
            var tarifaHora = (item.TarifaHora !== undefined && item.TarifaHora !== null) ? parseFloat(item.TarifaHora) : 0;
            var horasObjetivo = (item.HorasObjetivo !== undefined && item.HorasObjetivo !== null) ? parseFloat(item.HorasObjetivo) : 0;

            totalGeneral += monto;
            totalHorasGeneral += horas;
            totalDiasGeneral += dias;
            totalExcedentesGeneral += excedentes;

            var badgeExcedente = '';
            if (excedentesAcumulados > 0) {
                badgeExcedente = '<span class="badge bg-warning text-dark" title="Excedentes del ciclo anterior">+' + excedentesAcumulados.toFixed(2) + ' hrs acum.</span><br>';
            }
            badgeExcedente += excedentes > 0 ? '<span class="badge bg-info">+' + excedentes.toFixed(2) + ' hrs actuales</span>' : '-';

            tbody.append(
                '<tr>' +
                '<td>' + escapeHtml(item.NombreCompleto || '') + '<\/td>' +
                '<td>' + escapeHtml(item.Email || '') + '<\/td>' +
                '<td><span class="badge bg-primary">' + escapeHtml(item.RolPago || '') + '<\/span><\/td>' +
                '<td class="text-end">S/ ' + tarifaHora.toFixed(2) + '<\/td>' +
                '<td class="text-end">' + horasObjetivo.toFixed(2) + ' hrs<\/td>' +
                '<td class="text-center">' + dias + '<\/td>' +
                '<td class="text-end fw-bold">' + horas.toFixed(2) + ' hrs<\/td>' +
                '<td class="text-center">' + badgeExcedente + '<\/td>' +
                '<td><span class="badge bg-secondary">' + escapeHtml(item.Ciclo || '-') + '<\/span><\/td>' +
                '<td class="text-end fw-bold text-success">S/ ' + monto.toFixed(2) + '<\/td>' +
                '<td class="small text-muted">' + escapeHtml(item.DetalleHoras || '-') + '<\/td>' +
                '<\/tr>'
            );
        }

        $("#totalDias").text(totalDiasGeneral);
        $("#totalHoras").text(totalHorasGeneral.toFixed(2) + ' hrs');
        $("#totalExcedentes").text(totalExcedentesGeneral.toFixed(2) + ' hrs');
        $("#totalMonto").text('S/ ' + totalGeneral.toFixed(2));
        $("#tfootPagos").show();
    }



   // Función para exportar a Excel
function exportarExcel() {
    var usuarioId = $("#usuarioId").val();
    var rolPago = $("#rolPago").val();
    var ciclo = $("#ciclo").val();

    if (!ciclo) {
        Swal.fire({
            icon: 'info',
            title: 'Atención',
            text: 'Seleccione un ciclo para exportar'
        });
        return;
    }

    Swal.fire({
        title: 'Generando Excel...',
        text: 'Por favor espere',
        allowOutsideClick: false,
        didOpen: () => { Swal.showLoading(); }
    });

    var url = '@Url.Action("ExportarPagosPorCicloExcel", "Admin")?usuarioId=' + (usuarioId || '') +
              '&rolPago=' + (rolPago || '') +
              '&ciclo=' + encodeURIComponent(ciclo);
    window.location.href = url;

    setTimeout(() => { Swal.close(); }, 3000);
}


    // Función para limpiar filtros
    function limpiarFiltros() {
        $("#usuarioId").val('');
        $("#rolPago").val('');
        $("#ciclo").val('');
        $("#tbodyPagos").html(
            '<tr><td colspan="11" class="text-center text-muted py-5">' +
            '<i class="fas fa-info-circle fa-2x mb-2 d-block"></i>' +
            'Seleccione un ciclo y presione "Buscar"' +
            '<\/td><\/tr>'
        );
        $("#tfootPagos").hide();

        Swal.fire({
            icon: 'success',
            title: 'Filtros Limpiados',
            text: 'Los filtros han sido reiniciados',
            timer: 1500,
            showConfirmButton: false
        });
    }


    // Función auxiliar para escapar HTML
    function escapeHtml(str) {
        if (!str) return '';
        return String(str).replace(/[&<>]/g, function (m) {
            if (m === '&') return '&amp;';
            if (m === '<') return '&lt;';
            if (m === '>') return '&gt;';
            return m;
        });
    }


    // Función auxiliar para formatear montos
    function formatoMonto(valor) {
        if (valor === undefined || valor === null) return '0.00';
        return parseFloat(valor).toFixed(2);
    }
</script>