@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // RELOJ - Formato 24 HORAS
        function updateClockHeader() {
            const now = new Date();
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            document.getElementById('currentDateHeader').textContent = now.toLocaleDateString('es-PE', options);
            const hours = now.getHours().toString().padStart(2, '0');
            const minutes = now.getMinutes().toString().padStart(2, '0');
            const seconds = now.getSeconds().toString().padStart(2, '0');
            document.getElementById('currentTimeHeader').textContent = hours + ':' + minutes + ':' + seconds;
        }
        updateClockHeader();
        setInterval(updateClockHeader, 1000);

        // VARIABLES GLOBALES
        var esAdmin = @((ViewBag.EsAdmin ?? false).ToString().ToLower());
        var registrosActuales = [];
        var cargaEnProceso = false;
        var cacheRegistros = {
            datos: null,
            timestamp: 0,
            tiempoVida: 60000  // 1 minuto
        };
        var cacheTardanzas = {
            datos: null,
            timestamp: 0,
            tiempoVida: 60000  // 1 minuto
        };
        var cargandoTardanzas = false;
        var alertaModalVisible = false;
        var cerrandoPorAceptar = false;
        var cargasPendientes = 0;

        // ============================================
        // FUNCIÓN PARA RENDERIZAR TABLA DE REGISTROS - RÁPIDA
        // ============================================
        function renderizarTabla(data) {
            var tbody = $("#tbodyRegistros");
            if (!data || data.length === 0) {
                tbody.html('<tr><td colspan="3" class="text-center py-5 text-muted"><i class="fas fa-calendar-times fa-2x mb-2 d-block"></i>No hay registros hoy</td></tr>');
                registrosActuales = [];
                return;
            }
            data.sort(function (a, b) {
                return a.Hora.localeCompare(b.Hora);
            });
            var html = '';
            for (var i = 0; i < data.length; i++) {
                var item = data[i];
                var badgeClass = '';
                var horaMostrar = item.Hora;
                if (horaMostrar && horaMostrar.length > 5) {
                    horaMostrar = horaMostrar.substring(0, 5);
                }
                if (item.TipoRegistro === 'Entrada') {
                    badgeClass = 'bg-success';
                } else if (item.TipoRegistro === 'Almuerzo_Salida') {
                    badgeClass = 'bg-warning';
                } else if (item.TipoRegistro === 'Almuerzo_Retorno') {
                    badgeClass = 'bg-info';
                } else if (item.TipoRegistro === 'Salida') {
                    badgeClass = 'bg-danger';
                }
                html += '<tr>' +
                    '<td class="fw-bold">' + horaMostrar + '</td>' +
                    '<td><span class="badge ' + badgeClass + ' px-3 py-2 rounded-pill">' + item.TipoRegistro + '</span></td>' +
                    '<td class="text-muted">' + (item.Comentario || '-') + '</td>' +
                    '</tr>';
            }
            tbody.html(html);
            registrosActuales = data;
        }

        // ============================================
        // FUNCIÓN PARA RENDERIZAR TABLA DE TARDANZAS - RÁPIDA
        // ============================================
        function renderizarTardanzas(response) {
            var tbody = $("#tbodyTardanzas");
            var total = response.total || 0;
            $('#totalTardanzasCount').text(total);

            if (response.data && response.data.length > 0) {
                var html = '';
                for (var i = 0; i < response.data.length; i++) {
                    var item = response.data[i];
                    var badgeTurno = item.TipoJornada === 'Mañana'
                        ? '<span class="badge rounded-pill" style="background: linear-gradient(135deg, #00baff 0%, #007beb 100%); color: white; padding: 6px 12px;"><i class="bi bi-brightness-high-fill me-1"></i> Mañana</span>'
                        : '<span class="badge rounded-pill" style="background: linear-gradient(135deg, #f7b712 0%, #f28117 100%); color: white; padding: 6px 12px;"><i class="bi bi-brightness-alt-high-fill me-1"></i> Tarde</span>';
                    var colorMinutos = item.TipoJornada === 'Mañana' ? '#E87C00' : '#BD0808';
                    html += '<tr>' +
                        '<td class="fw-bold">' + item.Fecha + '</td>' +
                        '<td>' + badgeTurno + '</td>' +
                        '<td><strong>' + item.HoraIngreso + '</strong></td>' +
                        '<td><span style="font-weight: bold; color: ' + colorMinutos + ';">' + item.MinutosTardanza + ' min</span></td>' +
                        '</tr>';
                }
                tbody.html(html);
            } else {
                tbody.html(
                    '<tr><td colspan="4" class="text-center py-5 text-success">' +
                    '<i class="fas fa-check-circle fa-2x mb-2 d-block"></i>' +
                    '¡Felicidades! No tiene tardanzas este mes' +
                    '</td></tr>'
                );
            }
        }

        // ============================================
        // CARGAR REGISTROS DE HOY - CON CACHÉ
        // ============================================
        function cargarRegistrosHoy(forzarRecarga) {
            if (forzarRecarga === undefined) forzarRecarga = false;
            var ahora = new Date().getTime();

            // Usar caché si es válido
            if (!forzarRecarga && cacheRegistros.datos && (ahora - cacheRegistros.timestamp) < cacheRegistros.tiempoVida) {
                renderizarTabla(cacheRegistros.datos);
                return;
            }

            if (cargaEnProceso) return;
            cargaEnProceso = true;

            $.ajax({
                url: '@Url.Action("ObtenerRegistrosHoy", "Trabajador")',
                type: 'POST',
                dataType: 'json',
                timeout: 5000,
                success: function(data) {
                    cacheRegistros.datos = data || [];
                    cacheRegistros.timestamp = new Date().getTime();
                    renderizarTabla(cacheRegistros.datos);
                    cargaEnProceso = false;
                },
                error: function() {
                    if (!cacheRegistros.datos) {
                        $("#tbodyRegistros").html('<tr><td colspan="3" class="text-center py-5 text-danger"><i class="fas fa-exclamation-triangle fa-2x mb-2 d-block"></i>Error al cargar datos</td></tr>');
                    }
                    cargaEnProceso = false;
                }
            });
        }

        // ============================================
        // CARGAR TARDANZAS DEL MES - CON CACHÉ
        // ============================================
        function cargarTardanzasMes(forzarRecarga) {
            if (forzarRecarga === undefined) forzarRecarga = false;
            var ahora = new Date().getTime();

            if (!forzarRecarga && cacheTardanzas.datos && (ahora - cacheTardanzas.timestamp) < cacheTardanzas.tiempoVida) {
                renderizarTardanzas(cacheTardanzas.datos);
                return;
            }

            if (cargandoTardanzas) return;
            cargandoTardanzas = true;

            $.ajax({
                url: '@Url.Action("ObtenerTardanzasMes", "Trabajador")',
                type: 'POST',
                dataType: 'json',
                timeout: 5000,
                success: function(response) {
                    if (response.success) {
                        cacheTardanzas.datos = response;
                        cacheTardanzas.timestamp = new Date().getTime();
                        renderizarTardanzas(response);
                    } else {
                        if (!cacheTardanzas.datos) {
                            mostrarErrorTardanzas();
                        }
                    }
                    cargandoTardanzas = false;
                },
                error: function() {
                    if (!cacheTardanzas.datos) {
                        mostrarErrorTardanzas();
                    }
                    cargandoTardanzas = false;
                }
            });
        }

        function mostrarErrorTardanzas() {
            $("#tbodyTardanzas").html(
                '<tr><td colspan="4" class="text-center py-5 text-danger">' +
                '<i class="fas fa-exclamation-triangle fa-2x mb-2 d-block"></i>' +
                'Error al cargar tardanzas. <a href="#" onclick="cargarTardanzasMes(true); return false;">Reintentar</a>' +
                '</td></tr>'
            );
        }

        // ============================================
        // CARGA INICIAL - INMEDIATA
        // ============================================
        function cargarDatosIniciales() {
            // Intentar cargar desde caché primero (instantáneo)
            var ahora = new Date().getTime();

            if (cacheRegistros.datos && (ahora - cacheRegistros.timestamp) < cacheRegistros.tiempoVida) {
                renderizarTabla(cacheRegistros.datos);
            }

            if (cacheTardanzas.datos && (ahora - cacheTardanzas.timestamp) < cacheTardanzas.tiempoVida) {
                renderizarTardanzas(cacheTardanzas.datos);
            }

            // Cargar datos frescos en segundo plano
            cargarRegistrosHoy();
            setTimeout(function () {
                cargarTardanzasMes();
            }, 300);
        }

        // ============================================
        // EXISTE REGISTRO (para validaciones)
        // ============================================
        function existeRegistro(tipo) {
            return registrosActuales.some(function(registro) {
                return registro.TipoRegistro === tipo;
            });
        }

        function obtenerNombreTipo(tipo) {
            switch(tipo) {
                case 'Entrada': return 'ENTRADA';
                case 'Salida': return 'SALIDA';
                case 'Almuerzo_Salida': return 'SALIDA A ALMUERZO';
                case 'Almuerzo_Retorno': return 'RETORNO DE ALMUERZO';
                default: return tipo;
            }
        }

        // ============================================
        // VALIDAR ORDEN DE MARCACIÓN
        // ============================================
        function validarOrdenMarcacion(tipo) {
            var tieneEntrada = existeRegistro('Entrada');
            var tieneSalida = existeRegistro('Salida');
            var tieneSalidaAlmuerzo = existeRegistro('Almuerzo_Salida');
            var tieneRetornoAlmuerzo = existeRegistro('Almuerzo_Retorno');

            if (tieneSalida && tipo !== 'Entrada') {
                return {
                    valido: false,
                    mensaje: '❌ No puede registrar ' + obtenerNombreTipo(tipo) + ' porque ya ha registrado su SALIDA definitiva del día.\n\nEl horario laboral ha finalizado para hoy.'
                };
            }

            switch(tipo) {
                case 'Entrada':
                    if (tieneEntrada) {
                        return {
                            valido: false,
                            mensaje: '⚠️ Ya tiene registrada su ENTRADA hoy.\n\nSi necesita modificar este registro, contacte al administrador.'
                        };
                    }
                    break;
                case 'Salida':
                    if (!tieneEntrada) {
                        return {
                            valido: false,
                            mensaje: '❌ No puede registrar SALIDA porque no ha registrado ENTRADA hoy.\n\nPor favor, primero registre su hora de entrada.'
                        };
                    }
                    if (tieneSalidaAlmuerzo && !tieneRetornoAlmuerzo) {
                        return {
                            valido: false,
                            mensaje: '❌ No puede registrar SALIDA definitiva porque aún no ha registrado su RETORNO DE ALMUERZO.\n\nPrimero registre su retorno de almuerzo.'
                        };
                    }
                    break;
                case 'Almuerzo_Salida':
                    if (!tieneEntrada) {
                        return {
                            valido: false,
                            mensaje: '❌ No puede registrar SALIDA A ALMUERZO porque no ha registrado ENTRADA hoy.\n\nPor favor, primero registre su hora de entrada.'
                        };
                    }
                    if (tieneSalida) {
                        return {
                            valido: false,
                            mensaje: '❌ No puede registrar SALIDA A ALMUERZO porque ya ha registrado su SALIDA definitiva.\n\nEl horario laboral ya finalizó.'
                        };
                    }
                    if (tieneSalidaAlmuerzo) {
                        return {
                            valido: false,
                            mensaje: '⚠️ Ya tiene registrada su SALIDA A ALMUERZO hoy.\n\nAhora debe registrar su RETORNO DE ALMUERZO.'
                        };
                    }
                    break;
                case 'Almuerzo_Retorno':
                    if (!tieneSalidaAlmuerzo) {
                        return {
                            valido: false,
                            mensaje: '❌ No puede registrar RETORNO DE ALMUERZO porque no ha registrado SALIDA A ALMUERZO.\n\nPrimero registre su salida a almuerzo.'
                        };
                    }
                    if (tieneRetornoAlmuerzo) {
                        return {
                            valido: false,
                            mensaje: '⚠️ Ya tiene registrado su RETORNO DE ALMUERZO hoy.\n\nSolo puede registrar un retorno de almuerzo por día.'
                        };
                    }
                    if (tieneSalida) {
                        return {
                            valido: false,
                            mensaje: '❌ No puede registrar RETORNO DE ALMUERZO porque ya ha registrado su SALIDA definitiva.\n\nEl horario laboral ya finalizó.'
                        };
                    }
                    break;
            }
            return { valido: true, mensaje: '' };
        }

        // ============================================
        // MARCAR - SIN CAMBIOS
        // ============================================
        function marcar(tipo) {
            if (!esAdmin) {
                var validacion = validarOrdenMarcacion(tipo);
                if (!validacion.valido) {
                    Swal.fire({
                        icon: 'warning',
                        title: '⚠️ Orden de marcación incorrecto',
                        html: '<div style="text-align: left;"><p>' + validacion.mensaje.replace(/\n/g, '<br>') + '</p><hr><p class="text-muted">Si consideras que esto es un error, por favor comunícate con el área administrativa.</p></div>',
                        confirmButtonText: 'Entendido',
                        confirmButtonColor: '#3085d6',
                        showCancelButton: false
                    });
                    return;
                }
            }

            var comentario = $('#txtComentario').val();
            var titulo = '';
            var mensajeConfirmacion = '';

            switch(tipo) {
                case 'Entrada':
                    titulo = 'Registro de Entrada';
                    mensajeConfirmacion = '¿Desea registrar su hora de ENTRADA?';
                    break;
                case 'Salida':
                    titulo = 'Registro de Salida';
                    mensajeConfirmacion = '¿Desea registrar su SALIDA definitiva? Una vez registrada, no podrá marcar más entradas, almuerzos o retornos hoy.';
                    break;
                case 'Almuerzo_Salida':
                    titulo = 'Registro de Salida a Almuerzo';
                    mensajeConfirmacion = '¿Desea registrar su SALIDA A ALMUERZO? Deberá registrar su retorno después.';
                    break;
                case 'Almuerzo_Retorno':
                    titulo = 'Registro de Retorno de Almuerzo';
                    mensajeConfirmacion = '¿Desea registrar su RETORNO DE ALMUERZO?';
                    break;
            }

            Swal.fire({
                title: titulo,
                text: mensajeConfirmacion,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sí, registrar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Procesando...',
                        text: 'Registrando su marcación',
                        allowOutsideClick: false,
                        didOpen: function() { Swal.showLoading(); }
                    });

                    $.ajax({
                        url: '@Url.Action("Registrar", "Trabajador")',
                        type: 'POST',
                        data: { tipo: tipo, comentario: comentario },
                        success: function(response) {
                            Swal.close();
                            if (response.exito) {
                                cacheRegistros.datos = null;
                                cacheRegistros.timestamp = 0;
                                var mensajeExtra = '';
                                if (tipo === 'Salida') {
                                    mensajeExtra = '<br><br>🏁 Este día ya cuenta como DÍA TRABAJADO en el resumen del mes.';
                                    setTimeout(verificarSalidaPendiente, 1000);
                                } else if (tipo === 'Almuerzo_Salida') {
                                    mensajeExtra = '<br><br>🍽️ No olvide registrar su RETORNO DE ALMUERZO cuando regrese.';
                                }
                                Swal.fire({
                                    icon: 'success',
                                    title: '¡Registro Exitoso!',
                                    html: '✅ ' + response.mensaje + '<br><br>⏰ Hora: ' + new Date().toLocaleTimeString() + mensajeExtra,
                                    timer: 2500,
                                    showConfirmButton: false
                                });
                                $('#txtComentario').val('');
                                cargarRegistrosHoy(true);
                                cargarTardanzasMes(true);
                                setTimeout(verificarSalidaPendiente, 1500);
                                setTimeout(function() { location.reload(); }, 2500);
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: response.mensaje
                                });
                            }
                        },
                        error: function() {
                            Swal.close();
                            Swal.fire({
                                icon: 'error',
                                title: 'Error de conexión',
                                text: 'No se pudo conectar con el servidor'
                            });
                        }
                    });
                }
            });
        }

        // ============================================
        // ALERTA DE SALIDA PENDIENTE - RÁPIDA
        // ============================================
        function verificarSalidaPendiente() {
            if (alertaModalVisible) return;

            $.ajax({
                url: '@Url.Action("ObtenerAlertaSalidaPendiente", "Trabajador")',
                type: 'GET',
                dataType: 'json',
                timeout: 5000,
                success: function(response) {
                    if (response.success && response.tieneAlerta) {
                        if (response.fechaFormateada) {
                            $('#modalFechaPendiente').text('Fecha pendiente: ' + response.fechaFormateada);
                            $('#modalFechaCompleta').text(response.fechaFormateada);
                        }
                        if (response.diaSemana) {
                            $('#modalDiaSemana').text(response.diaSemana);
                        }
                        if (response.horaEntrada) {
                            $('#modalHoraEntrada').text(response.horaEntrada);
                        }
                        if (response.diasRetraso !== undefined) {
                            var textoDias = response.diasRetraso === 1 ? '1 día' : response.diasRetraso + ' días';
                            $('#modalDiasRetraso').text(textoDias);
                        }
                        if (response.mensaje) {
                            $('#modalMensajePendiente').text(response.mensaje);
                        }

                        if (!alertaModalVisible) {
                            $('#modalAlertaSalida').modal({
                                backdrop: 'static',
                                keyboard: false
                            });
                            $('#modalAlertaSalida').modal('show');
                            alertaModalVisible = true;
                            cerrandoPorAceptar = false;
                        }
                    } else {
                        if (alertaModalVisible) {
                            $('#modalAlertaSalida').modal('hide');
                            alertaModalVisible = false;
                            cerrandoPorAceptar = false;
                        }
                    }
                },
                error: function() {
                    setTimeout(verificarSalidaPendiente, 10000);
                }
            });
        }

        // ============================================
        // EVENTO PARA EL BOTÓN ACEPTAR
        // ============================================
        $(document).on('click', '#btnAceptarAlerta', function () {
            $('#btnAceptarAlerta').html('<i class="fas fa-spinner fa-spin me-2"></i> Procesando...');
            $('#btnAceptarAlerta').prop('disabled', true);

            $.ajax({
                url: '@Url.Action("RegistrarAceptacionAlertaSalida", "Trabajador")',
                type: 'POST',
                dataType: 'json',
                success: function(response) {
                    cerrandoPorAceptar = true;
                    $('#modalAlertaSalida').modal('hide');
                    alertaModalVisible = false;
                    $('#btnAceptarAlerta').html('<i class="fas fa-check me-2"></i> Aceptar');
                    $('#btnAceptarAlerta').prop('disabled', false);
                },
                error: function() {
                    cerrandoPorAceptar = true;
                    $('#modalAlertaSalida').modal('hide');
                    alertaModalVisible = false;
                    $('#btnAceptarAlerta').html('<i class="fas fa-check me-2"></i> Aceptar');
                    $('#btnAceptarAlerta').prop('disabled', false);
                    Swal.fire({
                        icon: 'warning',
                        title: 'Error al registrar',
                        text: 'No se pudo registrar su aceptación, pero la alerta no se mostrará nuevamente.',
                        timer: 3000,
                        showConfirmButton: false
                    });
                }
            });
        });

        // ============================================
        // EVITAR CIERRE DEL MODAL
        // ============================================
        $(document).on('click', '#modalAlertaSalida', function(e) {
            if ($(e.target).is('.modal') || $(e.target).is('.modal-backdrop')) {
                return false;
            }
        });

        $(document).on('keydown', function(e) {
            if (e.key === 'Escape' && $('#modalAlertaSalida').hasClass('show')) {
                e.preventDefault();
                e.stopPropagation();
                return false;
            }
        });

        $('#modalAlertaSalida').on('hide.bs.modal', function(e) {
            if (alertaModalVisible && !cerrandoPorAceptar) {
                e.preventDefault();
                e.stopPropagation();
                return false;
            }
        });

        $('#modalAlertaSalida').on('hidden.bs.modal', function() {
            alertaModalVisible = false;
            cerrandoPorAceptar = false;
        });

        // ============================================
        // SOLICITUD EXCEPCIONAL
        // ============================================
        var tipoPermisoGlobal = '@tipoPermisoExcepcional';

        function cargarOpcionesTipoPermiso() {
            var select = $('#tipoSolicitud');
            select.empty();
            var tieneEntrada = registrosActuales.some(function(r) { return r.TipoRegistro === 'Entrada'; });
            var tieneSalida = registrosActuales.some(function(r) { return r.TipoRegistro === 'Salida'; });
            var tieneSalidaAlmuerzo = registrosActuales.some(function(r) { return r.TipoRegistro === 'Almuerzo_Salida'; });
            var tieneRetornoAlmuerzo = registrosActuales.some(function(r) { return r.TipoRegistro === 'Almuerzo_Retorno'; });
            var opciones = [];

            switch(tipoPermisoGlobal) {
                case 'Entrada':
                    if (!tieneEntrada && !tieneSalida) {
                        opciones.push({ value: 'Entrada', text: 'Entrada', habilitado: true });
                    } else if (tieneEntrada) {
                        opciones.push({ value: 'Entrada', text: 'Entrada (ya registrada)', habilitado: false });
                    } else if (tieneSalida) {
                        opciones.push({ value: 'Entrada', text: 'Entrada (no disponible - ya tiene salida)', habilitado: false });
                    }
                    break;
                case 'Almuerzo_Salida':
                    if (!tieneSalidaAlmuerzo && tieneEntrada && !tieneSalida) {
                        opciones.push({ value: 'Almuerzo_Salida', text: 'Salida a Almuerzo', habilitado: true });
                    } else if (tieneSalidaAlmuerzo) {
                        opciones.push({ value: 'Almuerzo_Salida', text: 'Salida a Almuerzo (ya registrada)', habilitado: false });
                    } else if (!tieneEntrada) {
                        opciones.push({ value: 'Almuerzo_Salida', text: 'Salida a Almuerzo (requiere entrada primero)', habilitado: false });
                    } else if (tieneSalida) {
                        opciones.push({ value: 'Almuerzo_Salida', text: 'Salida a Almuerzo (no disponible - ya tiene salida)', habilitado: false });
                    }
                    break;
                case 'Almuerzo_Retorno':
                    if (!tieneRetornoAlmuerzo && tieneSalidaAlmuerzo && !tieneSalida) {
                        opciones.push({ value: 'Almuerzo_Retorno', text: 'Retorno de Almuerzo', habilitado: true });
                    } else if (tieneRetornoAlmuerzo) {
                        opciones.push({ value: 'Almuerzo_Retorno', text: 'Retorno de Almuerzo (ya registrado)', habilitado: false });
                    } else if (!tieneSalidaAlmuerzo) {
                        opciones.push({ value: 'Almuerzo_Retorno', text: 'Retorno de Almuerzo (requiere salida a almuerzo primero)', habilitado: false });
                    } else if (tieneSalida) {
                        opciones.push({ value: 'Almuerzo_Retorno', text: 'Retorno de Almuerzo (no disponible - ya tiene salida)', habilitado: false });
                    }
                    break;
                case 'Salida':
                    if (!tieneSalida && tieneEntrada && (!tieneSalidaAlmuerzo || tieneRetornoAlmuerzo)) {
                        opciones.push({ value: 'Salida', text: 'Salida', habilitado: true });
                    } else if (tieneSalida) {
                        opciones.push({ value: 'Salida', text: 'Salida (ya registrada)', habilitado: false });
                    } else if (!tieneEntrada) {
                        opciones.push({ value: 'Salida', text: 'Salida (requiere entrada primero)', habilitado: false });
                    } else if (tieneSalidaAlmuerzo && !tieneRetornoAlmuerzo) {
                        opciones.push({ value: 'Salida', text: 'Salida (complete retorno de almuerzo primero)', habilitado: false });
                    }
                    break;
                default:
                    if (!tieneEntrada && !tieneSalida) {
                        opciones.push({ value: 'Entrada', text: 'Entrada', habilitado: true });
                    }
                    if (!tieneSalidaAlmuerzo && tieneEntrada && !tieneSalida) {
                        opciones.push({ value: 'Almuerzo_Salida', text: 'Salida a Almuerzo', habilitado: true });
                    }
                    if (!tieneRetornoAlmuerzo && tieneSalidaAlmuerzo && !tieneSalida) {
                        opciones.push({ value: 'Almuerzo_Retorno', text: 'Retorno de Almuerzo', habilitado: true });
                    }
                    if (!tieneSalida && tieneEntrada && (!tieneSalidaAlmuerzo || tieneRetornoAlmuerzo)) {
                        opciones.push({ value: 'Salida', text: 'Salida', habilitado: true });
                    }
                    break;
            }

            for (var i = 0; i < opciones.length; i++) {
                if (opciones[i].habilitado) {
                    select.append('<option value="' + opciones[i].value + '">' + opciones[i].text + '</option>');
                }
            }

            if (select.children().length === 0) {
                select.append('<option value="" disabled>No hay opciones disponibles en este momento</option>');
                $('#btnSolicitar').prop('disabled', true);
            } else {
                $('#btnSolicitar').prop('disabled', false);
            }
        }

        $('#btnSolicitar').click(function() {
            var tipo = $('#tipoSolicitud').val();
            var hora = $('#horaSolicitud').val();
            var justificacion = $('#justificacionSolicitud').val();

            if (!hora) {
                Swal.fire('Atención', 'Seleccione la hora', 'warning');
                return;
            }
            if (!justificacion) {
                Swal.fire('Atención', 'Ingrese una justificación', 'warning');
                return;
            }
            if (!tipo) {
                Swal.fire('Atención', 'No hay opciones disponibles', 'warning');
                return;
            }

            var hoy = new Date();
            var fechaLocal = hoy.getFullYear() + '-' + String(hoy.getMonth() + 1).padStart(2, '0') + '-' + String(hoy.getDate()).padStart(2, '0');
            var fechaHoraStr = fechaLocal + 'T' + hora + ':00';

            Swal.fire({
                title: 'Enviar solicitud',
                text: '¿Está seguro de enviar esta solicitud?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí, enviar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Enviando...', allowOutsideClick: false, didOpen: function() { Swal.showLoading(); } });
                    $.ajax({
                        url: '@Url.Action("SolicitarMarcacionExcepcional", "Trabajador")',
                        type: 'POST',
                        data: { tipo: tipo, fechaHora: fechaHoraStr, justificacion: justificacion },
                        success: function(response) {
                            Swal.close();
                            if (response.success) {
                                Swal.fire('Solicitud Enviada', response.message, 'success');
                                $('#modalSolicitudExcepcional').modal('hide');
                                $('#horaSolicitud').val('');
                                $('#justificacionSolicitud').val('');
                                cacheRegistros.datos = null;
                                cargarRegistrosHoy(true);
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.close();
                            Swal.fire('Error', 'Error al enviar la solicitud', 'error');
                        }
                    });
                }
            });
        });

        $('#modalSolicitudExcepcional').on('show.bs.modal', function() {
            cargarOpcionesTipoPermiso();
        });

        // ============================================
        // DOCUMENT READY - CARGA INMEDIATA
        // ============================================
        $(document).ready(function () {
            // ============================================
            // 1. INMEDIATO: Verificar salida pendiente
            // ============================================
            verificarSalidaPendiente();

            // ============================================
            // 2. INMEDIATO: Mostrar datos desde caché o skeleton
            // ============================================
            cargarDatosIniciales();

            // ============================================
            // 3. REFRESCAR
            // ============================================
            $("#btnRefrescar").click(function () {
                cacheRegistros.datos = null;
                cacheRegistros.timestamp = 0;
                cacheTardanzas.datos = null;
                cacheTardanzas.timestamp = 0;
                cargarRegistrosHoy();
                setTimeout(function () {
                    cargarTardanzasMes();
                }, 300);
            });

            // ============================================
            // 4. VERIFICAR SALIDA PENDIENTE CADA 2 MINUTOS
            // ============================================
            setInterval(verificarSalidaPendiente, 120000);
        });
    </script>
