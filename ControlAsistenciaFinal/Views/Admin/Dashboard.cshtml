@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/css/all.min.css" rel="stylesheet" />

<style>
    /* ========== CONTENEDOR PRINCIPAL PARA LIMITAR ANCHO EN PANTALLAS GRANDES ========== */
    /* Este contenedor envuelve todo el contenido para que no se estire en pantallas grandes */
    .responsive-container {
        max-width: 1400px;
        margin: 0 auto;
        width: 100%;
    }

    /* ========== RESET Y BASE RESPONSIVA ========== */
    * {
        box-sizing: border-box;
    }

    body {
        overflow-x: hidden;
        width: 100%;
        max-width: 100vw;
        background: #f0f2f5;
    }

    /* Asegurar que el layout original se mantenga */
    .container-fluid, .container {
        width: 100%;
        padding-right: 15px;
        padding-left: 15px;
        margin-right: auto;
        margin-left: auto;
    }

    /* ========== ENCABEZADO RESPONSIVO ========== */
    .header-left {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        width: 100%;
    }

    .logo-header {
        height: auto;
        width: 100%;
        max-width: 230px;
        margin-bottom: 10px;
    }

    .header-left h2 {
        font-size: clamp(1.2rem, 1vw, 1.8rem);
        margin: 0;
        word-break: keep-all;
    }

    .header-left p {
        font-size: clamp(0.8rem, 3vw, 1rem);
    }

    /* ========== TARJETAS ESTADÍSTICAS - GRID RESPONSIVO ========== */
    .row {
        display: flex;
        flex-wrap: wrap;
        margin-right: -8px;
        margin-left: -8px;
    }

        .row > [class*="col-"] {
            padding-right: 8px;
            padding-left: 8px;
        }

    /* Tarjetas responsivas */
    .card {
        border: none;
        border-radius: 16px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        height: 100%;
        min-height: 130px;
    }

        .card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.15);
        }

    .card-body {
        padding: clamp(0.8rem, 3vw, 1.2rem);
        display: flex;
        flex-direction: column;
        height: 100%;
    }

        .card-body .d-flex {
            flex-wrap: wrap;
            gap: 10px;
        }

        .card-body h6 {
            font-size: clamp(0.7rem, 2.5vw, 0.9rem);
            margin-bottom: 5px;
            white-space: nowrap;
        }

        .card-body h2 {
            font-size: clamp(1.3rem, 5vw, 2rem);
            margin: 0;
            font-weight: bold;
        }

        .card-body .fa-3x {
            font-size: clamp(1.5rem, 6vw, 2.5rem);
        }

        .card-body .small {
            font-size: clamp(0.6rem, 2vw, 0.75rem);
            margin-top: 8px;
            display: inline-block;
        }

    /* ========== MENÚ RÁPIDO RESPONSIVO ========== */
    .card-header {
        padding: clamp(0.7rem, 3vw, 1rem);
    }

        .card-header i {
            font-size: clamp(0.9rem, 3vw, 1.1rem);
        }

    /* Grid de menú - se adapta automáticamente */
    .row .col-md-3 {
        flex: 0 0 auto;
        width: 100%;
    }

    /* Tablet y desktop pequeños */
    @@media (min-width: 576px) {
        .row .col-md-3 {
            width: 50%;
        }
    }

    /* Desktop normal */
    @@media (min-width: 992px) {
        .row .col-md-3 {
            width: 25%;
        }
    }

    /* Pantallas grandes (curvas, 4K) - SOLO limitamos el ancho del contenedor, no cambiamos diseño */
    @@media (min-width: 1400px) {
        .responsive-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .row .col-md-3 {
            width: 25%;
        }
    }

    /* Pantallas ultra grandes (1920px+) - mantenemos el diseño centrado */
    @@media (min-width: 1920px) {
        .responsive-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .row .col-md-3 {
            width: 25%;
        }
    }

    /* Elementos de menú centrados y responsivos */
    .row .col-md-3.text-center {
        margin-bottom: 20px;
    }

        .row .col-md-3.text-center div,
        .row .col-md-3.text-center a {
            display: inline-block;
            transition: transform 0.2s ease;
        }

            .row .col-md-3.text-center div:hover,
            .row .col-md-3.text-center a:hover {
                transform: scale(1.05);
            }

        .row .col-md-3.text-center i {
            font-size: clamp(1.5rem, 6vw, 2.5rem);
        }

        .row .col-md-3.text-center h5 {
            font-size: clamp(0.8rem, 3vw, 1rem);
            margin-top: 10px;
            margin-bottom: 5px;
            font-weight: 600;
        }

        .row .col-md-3.text-center p {
            font-size: clamp(0.65rem, 2.5vw, 0.8rem);
            margin-bottom: 0;
            color: #6c757d;
        }

    /* ========== MODAL RESPONSIVO ========== */
    .modal-dialog {
        margin: 1rem;
    }

    @@media (min-width: 576px) {
        .modal-dialog {
            max-width: 90%;
            margin: 1.75rem auto;
        }
    }

    @@media (min-width: 992px) {
        .modal-dialog.modal-lg {
            max-width: 800px;
        }
    }

    @@media (min-width: 1400px) {
        .modal-dialog.modal-lg {
            max-width: 900px;
        }
    }

    .modal-content {
        border-radius: 20px;
        overflow: hidden;
    }

    .modal-header {
        padding: clamp(0.8rem, 3vw, 1rem) clamp(1rem, 4vw, 1.5rem);
    }

        .modal-header h5 {
            font-size: clamp(1rem, 4vw, 1.25rem);
        }

    .modal-body {
        padding: clamp(0.8rem, 3vw, 1.5rem);
        overflow-x: auto;
    }

    /* Tablas responsivas - horizontal scroll en móvil */
    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    #tablaDetalle {
        min-width: 500px;
        width: 100%;
        font-size: clamp(0.7rem, 2.5vw, 0.9rem);
    }

        #tablaDetalle thead th {
            padding: clamp(8px, 2vw, 12px) clamp(8px, 2vw, 15px);
            white-space: nowrap;
        }

        #tablaDetalle tbody td {
            padding: clamp(8px, 2vw, 12px) clamp(8px, 2vw, 15px);
            word-break: break-word;
        }

    /* Badges responsivos */
    .badge {
        font-size: clamp(0.6rem, 2vw, 0.75rem);
        padding: clamp(3px, 1vw, 6px) clamp(6px, 2vw, 10px);
    }

    /* ========== ALERTAS RESPONSIVAS ========== */
    .alertas-container {
        max-height: 60vh;
        overflow-y: auto;
    }

    .alerta-card {
        padding: clamp(0.8rem, 3vw, 1rem);
    }

        .alerta-card h6 {
            font-size: clamp(0.85rem, 3vw, 1rem);
        }

        .alerta-card .small {
            font-size: clamp(0.6rem, 2vw, 0.75rem);
        }

    /* Tabs responsivos */
    .nav-tabs .nav-link {
        padding: clamp(6px, 2vw, 10px) clamp(10px, 3vw, 20px);
        font-size: clamp(0.75rem, 2.5vw, 0.9rem);
    }

    /* ========== AJUSTES PARA CELULARES ========== */
    @@media (max-width: 575.98px) {
        /* Stack vertical para todas las columnas */
        .row {
            flex-direction: column;
        }

            .row > [class*="col-"] {
                width: 100%;
                margin-bottom: 12px;
            }
        /* Tarjetas toman ancho completo */
        .card {
            margin-bottom: 0;
        }
        /* Menú rápido: 2 columnas en móvil */
        .row .col-md-3.text-center {
            width: 50%;
            display: inline-block;
            vertical-align: top;
        }
        /* Ajuste para el contenedor del menú */
        .card-body .row {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
        }
        /* Botones del modal más grandes para touch */
        .modal-footer .btn {
            padding: 8px 12px;
            font-size: 0.8rem;
        }
        /* Espaciado general */
        .container, .container-fluid {
            padding-left: 12px;
            padding-right: 12px;
        }
    }

    /* ========== AJUSTES PARA TABLETS ========== */
    @@media (min-width: 576px) and (max-width: 991.98px) {
        .row .col-md-3 {
            width: 50%;
        }

            .row .col-md-3.text-center {
                width: 33.33%;
            }
    }

    /* ========== ANIMACIONES Y MEJORAS VISUALES ========== */
    .card, .alerta-card, button, .nav-link {
        transition: all 0.2s ease-in-out;
    }

    /* Mejora para touch en móviles */
    @@media (hover: none) and (pointer: coarse) {
        .card:hover {
            transform: none;
        }

        button, .card, .alerta-card {
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
        }

            button:active, .card:active {
                transform: scale(0.98);
            }
    }

    /* Scrollbar personalizado pero responsivo */
    .alertas-container::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    @@media (min-width: 768px) {
        .alertas-container::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
    }
</style>

<!-- CONTENEDOR RESPONSIVO - Solo limita el ancho en pantallas grandes, NO cambia el diseño -->
<div class="responsive-container">
    <!-- Encabezado con logo centrado y título debajo -->
    <!-- Encabezado con logo arriba y título abajo, alineado a la izquierda -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="header-left">
                <img src="~/Content/images/Logo_Yaros_Group_2.png" alt="Yaros Group Peru" class="logo-header" />
                <h2><i class="fas fa-clock"></i> Control Asistencia</h2>
                <p class="text-muted">Bienvenido, <strong>@ViewBag.Nombre</strong></p>
            </div>
        </div>
    </div>

    <!-- Tarjetas de estadísticas -->
    <div class="row mb-4">
        <div class="col-md-3">
            <a href="@Url.Action("Usuarios", "Admin")" style="text-decoration: none; display: block;">
                <div class="card bg-primary text-white" style="cursor: pointer;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="card-title">Total Empleados</h5>
                                <h2 class="mb-0">@ViewBag.TotalEmpleados</h2>
                            </div>
                            <i class="fas fa-users fa-3x opacity-50"></i>
                        </div>
