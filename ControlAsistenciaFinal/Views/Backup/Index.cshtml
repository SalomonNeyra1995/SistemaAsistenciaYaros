        // LIMPIAR MODAL DE SUBIDA
        // ============================================

        $('#modalSubirArchivo').on('hidden.bs.modal', function() {
            $('#fileExcelRestaurar').val('');
            $('#vistaPreviaArchivo').hide();
            $('#btnSubirArchivo').show();
            $('#btnRestaurarSubido').hide();
            archivoSubido = null;
            tablasArchivoSubido = [];
        });

        // ============================================
        // INICIALIZACIÓN
        // ============================================

        $(document).ready(function() {
            $('#overlayProgreso').hide().removeClass('show');
            $('.modal-backdrop').remove();
            $('body').removeClass('modal-open');
            $('body').css('overflow', '');
            $('body').css('padding-right', '');
            console.log('Script de respaldo cargado correctamente');
        });
